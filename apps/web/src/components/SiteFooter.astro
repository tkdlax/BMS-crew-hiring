---
import { BRAND } from "../constants/brand";
import { hrefPath } from "../lib/assets";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={BRAND.logoWhite} alt="" class="footer-logo" width="160" height="40" />
      <p class="footer-tagline">We Move With You Every Step Of The Way</p>
      <p class="footer-meta">Locally owned &amp; operated since 1952</p>
    </div>
    <div class="footer-col">
      <p class="footer-heading">Operations hiring</p>
      <a href={hrefPath("operations/")}>Driver &amp; crew openings</a>
      <a href={hrefPath("")}>Operations home</a>
      <a href={BRAND.careersPage}>All company careers</a>
    </div>
    <div class="footer-col">
      <p class="footer-heading">Contact</p>
      <a href={BRAND.phoneHref}>{BRAND.phone}</a>
      <a href={BRAND.mainSite}>baileysallied.com</a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>US DOT 4205683 | CO PUC HHG-00739</p>
    <p>&copy; {year} Bailey&apos;s Moving &amp; Storage. All rights reserved.</p>
  </div>
</footer>
