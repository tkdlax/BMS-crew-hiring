---
import { BRAND } from "../constants/brand";

const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="header-inner">
    <a href={BRAND.mainSite} class="logo-link" aria-label="Bailey's Moving and Storage home">
      <img src={BRAND.logo} alt="Bailey's Moving and Storage" class="logo-img" width="180" height="44" />
    </a>
    <div class="header-actions">
      <a href={`${base}careers/`} class="header-link">Careers</a>
      <a href={BRAND.phoneHref} class="btn btn-phone">
        <svg class="icon-phone" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.56.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.56 1 1 0 01-.24 1.01l-2.2 2.2z"/>
        </svg>
        {BRAND.phone}
      </a>
    </div>
  </div>
</header>
