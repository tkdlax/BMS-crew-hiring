---
import { BRAND } from "../constants/brand";
---
<aside class="careers-crosslink">
  <div class="careers-crosslink__inner">
    <p class="careers-crosslink__label">Other opportunities</p>
    <h2 class="careers-crosslink__title">Looking for office, sales, or other roles?</h2>
    <p class="careers-crosslink__text">
      This site is for moving operations — drivers, crew members, and packers in the field.
      For our full list of company careers, visit our main careers page.
    </p>
    <a href={BRAND.careersPage} class="btn btn-secondary careers-crosslink__btn">
      View all careers at Bailey&apos;s →
    </a>
  </div>
</aside>
