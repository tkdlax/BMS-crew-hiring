---
import type { JobVideo } from "../../lib/jobPageContent";

interface Props {
  title: string;
  videos: JobVideo[];
}

const { title, videos } = Astro.props;
---
<section class="video-section" id="videos">
  <h2 class="section-title video-section__title">{title}</h2>
  <div class="video-grid">
    {videos.map((v) => (
      <article class="video-card">
        <h3 class="video-card__heading">{v.title}</h3>
        <div class="video-card__embed">
          <iframe
            src={`https://www.youtube.com/embed/${v.youtubeId}?rel=0&controls=1`}
            title={v.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      </article>
    ))}
  </div>
</section>
