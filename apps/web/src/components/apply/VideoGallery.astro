---
import YoutubeEmbed from "../YoutubeEmbed.astro";
import type { JobVideo } from "../../lib/jobPageContent";

interface Props {
  title: string;
  videos: JobVideo[];
  /** Omit outer section chrome when nested inside ApplyLearnSection. */
  bare?: boolean;
}

const { title, videos, bare = false } = Astro.props;
---
<div class:list={[bare ? "apply-videos-block" : "apply-videos-section"]} {...(!bare && { id: "videos" })}>
  <p class="apply-section-eyebrow">On the job</p>
  <h2 class="apply-section-title">{title}</h2>
  <p class="apply-section-sub">Short videos from our team and customers.</p>
  <div class="apply-videos-grid">
    {videos.map((v) => (
      <article class="apply-video-card">
        <p class="apply-video-card__label">{v.title}</p>
        <YoutubeEmbed youtubeId={v.youtubeId} title={v.title} />
      </article>
    ))}
  </div>
</div>
