---
import { CAREER_PATH_ROLE, CAREER_PATH_STORIES } from "../constants/careerPath";
import YoutubeEmbed from "./YoutubeEmbed.astro";
---
<div class="career-stories">
  <p class="career-stories__proof">This is what the summit looks like.</p>
  <ul class="career-stories__grid">
    {CAREER_PATH_STORIES.map((story) => (
      <li>
        <article class="career-story">
          <div class="career-story__media">
            <YoutubeEmbed
              youtubeId={story.youtubeId}
              title={`${story.name} — ${CAREER_PATH_ROLE}`}
              badge={story.angle}
            />
          </div>
          <div class="career-story__body">
            <h4 class="career-story__quote">{story.quote}</h4>
            <p class="career-story__name">{story.name}</p>
            <p class="career-story__role">{CAREER_PATH_ROLE}</p>
            {story.stats.length > 0 && (
              <dl class="career-story__stats">
                {story.stats.map((stat) => (
                  <div class="career-story__stat">
                    <dd>{stat.value}</dd>
                    <dt>{stat.label}</dt>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </article>
      </li>
    ))}
  </ul>
</div>
