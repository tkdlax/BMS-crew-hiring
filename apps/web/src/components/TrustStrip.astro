---
import { BRAND } from "../constants/brand";
---
<div class="trust-strip">
  <div class="trust-strip__inner">
    <div class="trust-strip__item">
      <img src={BRAND.alliedLogo} alt="Allied Van Lines Agent" class="trust-strip__logo" />
    </div>
    <div class="trust-strip__item">
      <p class="trust-strip__stat">70+</p>
      <p class="trust-strip__label">Years in business</p>
    </div>
    <div class="trust-strip__item">
      <p class="trust-strip__stat">10K+</p>
      <p class="trust-strip__label">Families moved</p>
    </div>
    <div class="trust-strip__item">
      <p class="trust-strip__stat">4.9★</p>
      <p class="trust-strip__label">Google rating</p>
    </div>
  </div>
</div>
