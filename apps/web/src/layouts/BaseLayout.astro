---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { BRAND } from "../constants/brand";
import { assetUrl } from "../lib/assets.ts";

const privacyUrl = `${BRAND.mainSite}/privacy-policy`;

interface Props {
  title: string;
  bodyClass?: string;
  hideHero?: boolean;
  /** Apply page uses its own header/footer chrome (mockup layout). */
  applyChrome?: boolean;
}
const { title, bodyClass = "", hideHero = false, applyChrome = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Apply for driver, crew, and moving operations roles at Bailey's Moving &amp; Storage in Colorado and Utah." />
    <title>{title} | Bailey&apos;s Operations Hiring</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={assetUrl("styles/applicant.css")} />
  </head>
  <body class={`baileys-hiring ${bodyClass}`}>
    {!applyChrome && <SiteHeader />}
    <main class:list={["site-main", applyChrome && "site-main--apply"]} data-hide-hero={hideHero ? "true" : "false"}>
      <slot />
    </main>
    {!applyChrome && <SiteFooter />}
    {applyChrome && (
      <footer class="apply-footer">
        <p>
          © Bailey&apos;s Moving &amp; Storage · An Agent for Allied Van Lines ·{" "}
          <a href={privacyUrl}>Privacy</a>
        </p>
      </footer>
    )}
  </body>
</html>
