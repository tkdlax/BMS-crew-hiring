---
interface Props {
  title: string;
  bodyClass?: string;
}
const { title, bodyClass = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | BMS Hiring</title>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}styles/applicant.css`} />
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <a href={`${import.meta.env.BASE_URL}`} class="logo">BMS Careers</a>
    </header>
    <main class="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} BMS. All rights reserved.</p>
    </footer>
  </body>
</html>
