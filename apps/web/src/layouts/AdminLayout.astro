---
import { assetUrl, hrefPath } from "../lib/assets.ts";

interface Props {
  title: string;
  /** When false (e.g. login page), skip session check and redirect to login. */
  requireAuth?: boolean;
  /** Hide top nav (used on login). */
  showNav?: boolean;
}

const { title, requireAuth = true, showNav = requireAuth } = Astro.props;
const loginPath = hrefPath("admin/login/");
const adminHome = hrefPath("admin/");
---
<!doctype html>
<html
  lang="en"
  data-admin-auth={requireAuth ? "checking" : "skip"}
  data-login-path={loginPath}
  data-admin-home={adminHome}
  data-require-auth={requireAuth ? "1" : "0"}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Bailey&apos;s Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={assetUrl("styles/admin.css")} />
  </head>
  <body class="admin-body">
    {showNav && (
    <nav class="admin-nav">
      <a href={hrefPath("admin/")}>Dashboard</a>
      <a href={hrefPath("admin/offices/")}>Offices</a>
      <a href={hrefPath("admin/jobs/")}>Jobs</a>
      <a href={hrefPath("admin/applications/")}>Applications</a>
      <a href={hrefPath("admin/templates/")}>Templates</a>
      <a href={hrefPath("admin/settings/")}>Settings</a>
      <button type="button" id="admin-logout" class="btn-text">Log out</button>
    </nav>
    )}
    <main class="admin-main">
      <div id="admin-config-error" class="admin-card alert alert-error" role="alert" hidden>
        <strong>API not configured.</strong> Set <code>PUBLIC_API_BASE_URL</code> in Webflow Cloud (e.g.
        <code>https://&lt;your-function-app&gt;.azurewebsites.net/api</code>) and redeploy.
      </div>
      <slot />
    </main>
    <script>
      import {
        initAdminLoginRedirect,
        initAdminSessionGuard,
        resolveAdminApiBaseUrl,
      } from "../lib/api.client.ts";

      const root = document.documentElement;
      const loginPath = root.dataset.loginPath!;
      const adminHome = root.dataset.adminHome!;
      const requireAuth = root.dataset.requireAuth === "1";

      if (requireAuth) {
        initAdminSessionGuard(loginPath);
      } else {
        initAdminLoginRedirect(adminHome);
      }

      document.getElementById("admin-logout")?.addEventListener("click", async () => {
        const api = await resolveAdminApiBaseUrl();
        if (!api) return;
        await fetch(`${api}/logout`, { method: "POST", credentials: "include" });
        location.href = new URL("admin/login/", document.baseURI).href;
      });
    </script>
  </body>
</html>
