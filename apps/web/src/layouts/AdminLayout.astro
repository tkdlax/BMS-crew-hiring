---
import { assetUrl } from "../lib/assets.ts";

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Bailey&apos;s Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={assetUrl("styles/admin.css")} />
  </head>
  <body class="admin-body">
    <nav class="admin-nav">
      <a href={`${base}admin/`}>Dashboard</a>
      <a href={`${base}admin/offices/`}>Offices</a>
      <a href={`${base}admin/jobs/`}>Jobs</a>
      <a href={`${base}admin/applications/`}>Applications</a>
      <a href={`${base}admin/templates/`}>Templates</a>
      <a href={`${base}admin/settings/`}>Settings</a>
      <button type="button" id="admin-logout" class="btn-text">Log out</button>
    </nav>
    <main class="admin-main">
      <slot />
    </main>
    <script>
      const api = import.meta.env.PUBLIC_API_BASE_URL;
      document.getElementById("admin-logout")?.addEventListener("click", async () => {
        await fetch(`${api}/admin/logout`, { method: "POST", credentials: "include" });
        location.href = `${import.meta.env.BASE_URL}admin/login/`;
      });
    </script>
  </body>
</html>
