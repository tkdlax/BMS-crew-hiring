---
import { assetUrl, hrefPath } from "../lib/assets.ts";

interface Props {
  title: string;
  /** When false (e.g. login page), skip session check and redirect to login. */
  requireAuth?: boolean;
  /** Hide sidebar (used on login). */
  showNav?: boolean;
  /** Highlight active sidebar link. */
  activeNav?: string;
}

const { title, requireAuth = true, showNav = requireAuth, activeNav = "" } = Astro.props;
const loginPath = hrefPath("admin/login/");
const adminHome = hrefPath("admin/");

const nav = [
  { key: "scheduling", href: hrefPath("admin/"), label: "Scheduling", icon: "📅" },
  { key: "applications", href: hrefPath("admin/applications/"), label: "Applications", icon: "👤" },
  { key: "availability", href: hrefPath("admin/scheduling/"), label: "Availability", icon: "🕐" },
  { key: "offices", href: hrefPath("admin/offices/"), label: "Offices", icon: "🏢" },
  { key: "jobs", href: hrefPath("admin/jobs/"), label: "Jobs", icon: "💼" },
  { key: "templates", href: hrefPath("admin/templates/"), label: "Workflows", icon: "⚡" },
  { key: "settings", href: hrefPath("admin/settings/"), label: "Settings", icon: "⚙️" },
];
---
<!doctype html>
<html
  lang="en"
  data-admin-auth={requireAuth ? "checking" : "skip"}
  data-login-path={loginPath}
  data-admin-home={adminHome}
  data-require-auth={requireAuth ? "1" : "0"}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Bailey&apos;s Hiring Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={assetUrl("styles/admin.css")} />
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      {showNav && (
        <aside class="admin-sidebar">
          <div class="admin-sidebar__brand">
            <span class="admin-sidebar__brand-mark" aria-hidden="true"></span>
            Bailey&apos;s Hiring
          </div>
          <nav class="admin-sidebar__nav" aria-label="Admin">
            {nav.map((item) => (
              <a
                href={item.href}
                class:list={["admin-sidebar__link", activeNav === item.key && "active"]}
                data-nav={item.key}
              >
                <span class="admin-sidebar__icon" aria-hidden="true">{item.icon}</span>
                {item.label}
              </a>
            ))}
          </nav>
          <div class="admin-sidebar__footer">
            <button type="button" id="admin-logout" class="admin-sidebar__link admin-sidebar__logout">
              <span class="admin-sidebar__icon" aria-hidden="true">↩</span>
              Log out
            </button>
          </div>
        </aside>
      )}
      <div class="admin-content">
        {showNav && (
          <header class="admin-topbar">
            <h1>{title}</h1>
          </header>
        )}
        <main class:list={["admin-main", !showNav && "admin-main--login"]}>
          <div id="admin-config-error" class="admin-card alert alert-error" role="alert" hidden>
            <strong>API not configured.</strong> Set <code>PUBLIC_API_BASE_URL</code> in Webflow Cloud and redeploy.
          </div>
          <slot />
        </main>
      </div>
    </div>
    <script>
      import {
        initAdminLoginRedirect,
        initAdminSessionGuard,
        resolveAdminApiBaseUrl,
      } from "../lib/api.client.ts";

      const root = document.documentElement;
      const loginPath = root.dataset.loginPath!;
      const adminHome = root.dataset.adminHome!;
      const requireAuth = root.dataset.requireAuth === "1";

      if (requireAuth) {
        initAdminSessionGuard(loginPath);
      } else {
        initAdminLoginRedirect(adminHome);
      }

      const path = location.pathname;
      document.querySelectorAll(".admin-sidebar__link[data-nav]").forEach((el) => {
        const href = (el as HTMLAnchorElement).getAttribute("href");
        if (href && path.includes(href.replace(/\/$/, ""))) {
          el.classList.add("active");
        }
      });

      document.getElementById("admin-logout")?.addEventListener("click", async () => {
        const api = await resolveAdminApiBaseUrl();
        if (!api) return;
        await fetch(`${api}/logout`, { method: "POST", credentials: "include" });
        location.href = loginPath;
      });
    </script>
  </body>
</html>
