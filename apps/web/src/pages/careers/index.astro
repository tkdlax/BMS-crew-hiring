---
import BaseLayout from "../../layouts/BaseLayout.astro";

const api = import.meta.env.PUBLIC_API_BASE_URL;
const base = import.meta.env.BASE_URL;

let openings: Array<{
  office_slug: string;
  office_name: string;
  job_slug: string;
  job_title: string;
}> = [];

try {
  const res = await fetch(`${api}/public/openings`);
  if (res.ok) {
    const data = await res.json();
    openings = data.openings ?? [];
  }
} catch {
  /* dev without API */
}
---
<BaseLayout title="Open positions">
  <section class="page-band">
    <div class="page-band__inner">
      <p class="eyebrow">Careers</p>
      <h1>Open positions</h1>
      <p class="sub">Select a role below to start your application. Most applications take about 3 minutes.</p>
    </div>
  </section>

  <div class="page-wrap page-wrap--narrow">
    {openings.length === 0 ? (
      <div class="content-card">
        <p class="lead" style="margin-bottom: 0;">
          No openings are listed right now. Please check back soon or call us at{" "}
          <a href="tel:+18882605717" style="color: var(--orange); font-weight: 700;">888-260-5717</a>.
        </p>
      </div>
    ) : (
      <>
        <p class="section-label">{openings.length} roles available</p>
        <ul class="job-grid">
          {openings.map((o) => (
            <li>
              <a class="job-card" href={`${base}apply/${o.office_slug}/${o.job_slug}/`}>
                <span class="job-card__title">{o.job_title}</span>
                <span class="job-card__meta">{o.office_name}</span>
                <span class="job-card__cta">Apply now →</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</BaseLayout>
