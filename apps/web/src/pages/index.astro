---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrustStrip from "../components/TrustStrip.astro";
import CareersCrosslink from "../components/CareersCrosslink.astro";
import { BRAND } from "../constants/brand";

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Operations hiring">
  <section
    class="hero"
    style={`--hero-bg: url('${BRAND.heroImage}')`}
  >
    <div class="hero__inner" style="max-width: 1200px; margin: 0 auto; width: 100%;">
      <p class="hero__eyebrow">Drivers &amp; moving crew</p>
      <h1>Join our <span class="accent">operations</span> team</h1>
      <p class="hero__lead">
        Bailey&apos;s is built by the people on the trucks and on the job site — drivers, movers,
        and packers who keep families and businesses moving across Colorado and Utah.
        Apply in minutes from your phone.
      </p>
      <div class="hero__badges">
        <span class="hero__badge">Drivers &amp; CDL roles</span>
        <span class="hero__badge">Crew &amp; packers</span>
        <span class="hero__badge">Training provided</span>
      </div>
      <a href={`${base}careers/`} class="btn btn-primary" style="max-width: 22rem;">
        View driver &amp; crew openings →
      </a>
    </div>
  </section>

  <TrustStrip />

  <div class="page-wrap">
    <p class="section-label">Operations careers</p>
    <h2 class="section-title">Work in the field, not behind a desk</h2>
    <p class="lead">
      We hire for moving operations — the roles that show up, load the truck, and deliver
      on every promise we make. No moving experience required for most crew positions;
      we train you. Competitive pay, tips, and full-time benefits where applicable.
    </p>
    <ul class="ops-role-list">
      <li class="ops-role-list__item">
        <strong>Drivers</strong> — Local and linehaul routes; CDL training available for qualified candidates.
      </li>
      <li class="ops-role-list__item">
        <strong>Crew members &amp; packers</strong> — On-site moving and packing; seasonal and full-time options.
      </li>
    </ul>
    <a href={`${base}careers/`} class="btn btn-secondary" style="width: 100%; max-width: 22rem;">
      See open operations roles
    </a>
  </div>

  <CareersCrosslink />
</BaseLayout>
