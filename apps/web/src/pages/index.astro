---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrustStrip from "../components/TrustStrip.astro";
import CareersCrosslink from "../components/CareersCrosslink.astro";
import { BRAND } from "../constants/brand";
import { hrefPath } from "../lib/assets";
---
<BaseLayout title="Operations hiring">
  <section
    class="hero"
    style={`--hero-bg: url('${BRAND.heroImage}')`}
  >
    <div class="hero__inner" style="max-width: 1200px; margin: 0 auto; width: 100%;">
      <p class="hero__eyebrow">Moving operations crew</p>
      <h1>Join our <span class="accent">operations</span> team</h1>
      <p class="hero__lead">
        Bailey&apos;s is built by the people on the trucks and on the job site — movers, drivers,
        and packers across Colorado and Utah. Each office hires one moving operations crew;
        you choose your focus when you apply.
      </p>
      <div class="hero__badges">
        <span class="hero__badge">Full-time or seasonal</span>
        <span class="hero__badge">Training provided</span>
        <span class="hero__badge">Career progression</span>
      </div>
      <a href={hrefPath("operations/")} class="btn btn-primary" style="max-width: 22rem;">
        View operations openings →
      </a>
    </div>
  </section>

  <TrustStrip />

  <div class="page-wrap">
    <p class="section-label">Operations careers</p>
    <h2 class="section-title">Work in the field, not behind a desk</h2>
    <p class="lead">
      We hire <strong>moving operations crew</strong> in each office — the team that shows up,
      loads the truck, and delivers on every promise we make. On the application you&apos;ll tell us
      whether you&apos;re most interested in driving, moving &amp; packing, seasonal work, or starting a new career.
      No moving experience required; we train you.
    </p>
    <p class="lead home-cta-intro">
      Ready to apply, or curious how movers grow into team leaders and CDL drivers?
    </p>
    <div class="home-cta-row">
      <a href={hrefPath("operations/")} class="btn btn-secondary">See open operations roles</a>
      <a href={hrefPath("career-path/")} class="btn btn-secondary">See career path possibilities</a>
    </div>
  </div>

  <CareersCrosslink />
</BaseLayout>
