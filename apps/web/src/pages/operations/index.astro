---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getRuntimeApiBaseUrl } from "../../lib/api";
import {
  fetchOpeningsFromApi,
  groupOpeningsByOffice,
  staticOperationsOpenings,
} from "../../lib/openings";
import { hrefPath } from "../../lib/assets";
import { PAGE_SEO } from "../../lib/seo";

const api = getRuntimeApiBaseUrl(Astro.locals);

let rawOpenings = await fetchOpeningsFromApi(api);
if (!rawOpenings.length) {
  rawOpenings = staticOperationsOpenings();
}

const officeGroups = groupOpeningsByOffice(rawOpenings);
const showClientRefresh = !api;
---

<BaseLayout
  title={PAGE_SEO.operations.title}
  description={PAGE_SEO.operations.description}
  ogImage={PAGE_SEO.operations.ogImage}
  ogImageAlt="Bailey's crew members lifting equipment on a move"
>
  <section class="page-band">
    <div class="page-band__inner">
      <p class="eyebrow">Operations hiring</p>
      <h1>Moving operations crew</h1>
      <p class="sub">
        One team per office — Denver, Colorado Springs, Grand Junction, and Salt Lake City.
        Apply in about 2 minutes; tell us what you&apos;re most interested in on the form.
      </p>
    </div>
  </section>

  <div class="page-wrap careers-by-office" id="operations-list" data-ssr-loaded={api ? "1" : "0"}>
    <p class="section-label" id="operations-summary">
      {officeGroups.length} {officeGroups.length === 1 ? "office" : "offices"} hiring moving operations crew
    </p>
    {officeGroups.map((office) => (
      <section class="office-group" id={office.slug}>
        <h2 class="office-group__title">{office.name}</h2>
        <ul class="job-grid">
          {office.jobs.map((o) => (
            <li>
              <a
                class="job-card"
                href={hrefPath(`apply/${o.office_slug}/${o.job_slug}/`)}
              >
                <span class="job-card__title">{o.job_title}</span>
                <span class="job-card__meta">{office.name}</span>
                <span class="job-card__cta">Apply now →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

{showClientRefresh && (
  <script>
    import { resolveApiBaseUrl } from "../../lib/api.client.ts";
    import { groupOpeningsByOffice } from "../../lib/openings.ts";
    import { hrefPath } from "../../lib/assets.ts";

    async function refreshOperationsList() {
      const api = await resolveApiBaseUrl();
      if (!api) return;

      const res = await fetch(`${api}/public/openings`);
      if (!res.ok) return;

      const data = await res.json();
      const groups = groupOpeningsByOffice(data.openings ?? []);
      if (!groups.length) return;

      const root = document.getElementById("operations-list");
      const summary = document.getElementById("operations-summary");
      if (!root) return;

      if (summary) {
        summary.textContent = `${groups.length} ${groups.length === 1 ? "office" : "offices"} hiring moving operations crew`;
      }

      root.innerHTML = (summary ? summary.outerHTML : "") + groups
        .map(
          (office) => `
        <section class="office-group" id="${office.slug}">
          <h2 class="office-group__title">${office.name}</h2>
          <ul class="job-grid">
            ${office.jobs
              .map(
                (o) => `
              <li>
                <a class="job-card" href="${hrefPath(`apply/${o.office_slug}/${o.job_slug}/`)}">
                  <span class="job-card__title">${o.job_title}</span>
                  <span class="job-card__meta">${office.name}</span>
                  <span class="job-card__cta">Apply now →</span>
                </a>
              </li>`
              )
              .join("")}
          </ul>
        </section>`
        )
        .join("");
    }

    refreshOperationsList();
  </script>
)}
