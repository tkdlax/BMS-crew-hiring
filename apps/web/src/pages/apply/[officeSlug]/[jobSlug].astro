---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import ApplyHeroShell from "../../../components/apply/ApplyHeroShell.astro";
import VideoGallery from "../../../components/apply/VideoGallery.astro";
import JobDetailsCard from "../../../components/apply/JobDetailsCard.astro";
import TrustStrip from "../../../components/TrustStrip.astro";
import { BRAND } from "../../../constants/brand";
import { OPERATIONS_JOB_SLUG, LEGACY_JOB_SLUGS } from "../../../constants/jobs";
import { OPERATIONS_OFFICE_ORDER } from "../../../constants/offices";
import { isKnownOperationsOffice, mergeJobPageContent } from "../../../lib/jobPageContent";
import { officeDisplayName } from "../../../lib/openings";
import {
  getApiBaseUrl,
  getRuntimeApiBaseUrl,
  getRuntimeCaptchaSiteKey,
} from "../../../lib/api";
import { hrefPath } from "../../../lib/assets";

export async function getStaticPaths() {
  const api = getApiBaseUrl();
  const fallback = OPERATIONS_OFFICE_ORDER.map((officeSlug) => ({
    params: { officeSlug, jobSlug: OPERATIONS_JOB_SLUG },
  }));

  if (!api) return fallback;

  try {
    const res = await fetch(`${api}/public/openings`);
    if (!res.ok) return fallback;
    const { openings } = await res.json();
    if (!openings?.length) return fallback;
    return openings
      .filter((o: { job_slug: string }) => !LEGACY_JOB_SLUGS.includes(o.job_slug as typeof LEGACY_JOB_SLUGS[number]))
      .map((o: { office_slug: string; job_slug: string }) => ({
        params: { officeSlug: o.office_slug, jobSlug: o.job_slug },
      }));
  } catch {
    return fallback;
  }
}

const { officeSlug, jobSlug } = Astro.params;
const api = getRuntimeApiBaseUrl(Astro.locals);
const captchaKey = getRuntimeCaptchaSiteKey(Astro.locals);
const captchaProvider =
  (Astro.locals.runtime?.env?.CAPTCHA_PROVIDER as string) ||
  import.meta.env.PUBLIC_CAPTCHA_PROVIDER ||
  "turnstile";
const captchaProviderNorm =
  captchaProvider === "recaptcha" ? "recaptcha" : ("turnstile" as const);

const privacyUrl = `${BRAND.mainSite}/privacy-policy`;
const operationsUrl = hrefPath("operations/");

const knownOpsApply =
  Boolean(officeSlug && jobSlug === OPERATIONS_JOB_SLUG && isKnownOperationsOffice(officeSlug!));

let job: Record<string, unknown> | null = null;
let loadError = "";

if (api) {
  try {
    const res = await fetch(`${api}/public/jobs/${officeSlug}/${jobSlug}`);
    if (res.ok) job = await res.json();
    else if (!knownOpsApply) {
      loadError = res.status === 404 ? "This position is not available." : "Unable to load job.";
    }
  } catch {
    if (!knownOpsApply) loadError = "Unable to connect. Please try again later.";
  }
} else if (!knownOpsApply) {
  loadError = "Unable to connect. Please try again later.";
}

const pageContent =
  officeSlug && jobSlug
    ? mergeJobPageContent(officeSlug, jobSlug, job?.pageContent as Record<string, unknown>, {
        title: job?.title ? String(job.title) : "Moving Operations Crew",
        officeName: job?.officeName ? String(job.officeName) : officeDisplayName(officeSlug),
        locationLabel: job?.locationLabel ? String(job.locationLabel) : "",
      })
    : null;

const showApply = Boolean(pageContent && (job || knownOpsApply));
---

<BaseLayout title={pageContent?.headline ?? "Apply"} bodyClass="page-apply" applyChrome>
  {loadError ? (
    <>
      <section class="page-band">
        <div class="page-band__inner">
          <h1>Position unavailable</h1>
          <p class="sub">{loadError}</p>
        </div>
      </section>
      <div class="page-wrap">
        <a href={operationsUrl} class="btn btn-secondary">Back to operations openings</a>
      </div>
    </>
  ) : showApply && pageContent ? (
    <>
      <ApplyHeroShell
        content={pageContent}
        officeSlug={officeSlug!}
        jobSlug={jobSlug!}
        captchaSiteKey={captchaKey}
        captchaProvider={captchaProviderNorm}
        privacyUrl={privacyUrl}
      />

      <TrustStrip />

      {pageContent.videos && pageContent.videos.length > 0 && pageContent.learnSectionTitle && (
        <VideoGallery title={pageContent.learnSectionTitle} videos={pageContent.videos} />
      )}

      {pageContent.jobDetails && (
        <section class="apply-details-section page-wrap">
          <JobDetailsCard details={pageContent.jobDetails} />
        </section>
      )}
    </>
  ) : (
    <div class="page-wrap">
      <p class="lead">Loading position details…</p>
    </div>
  )}
</BaseLayout>

{captchaKey && captchaProviderNorm === "recaptcha" && (
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
)}
{captchaKey && captchaProviderNorm === "turnstile" && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  import { resolveApiBaseUrl, resolveCaptchaSiteKey } from "../../../lib/api.client.ts";

  const form = document.getElementById("apply-form") as HTMLFormElement | null;
  const alertEl = document.getElementById("form-alert");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  function showAlert(msg: string, type: "error" | "success") {
    if (!alertEl) return;
    alertEl.hidden = false;
    alertEl.className = `form-alert alert alert-${type}`;
    alertEl.textContent = msg;
    alertEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function splitName(full: unknown) {
    const parts = String(full || "")
      .trim()
      .split(/\s+/)
      .filter(Boolean);
    if (!parts.length) return { firstName: "", lastName: "" };
    if (parts.length === 1) return { firstName: parts[0]!, lastName: parts[0]! };
    return { firstName: parts[0]!, lastName: parts.slice(1).join(" ") };
  }

  async function getCaptchaToken() {
    const captchaKey = await resolveCaptchaSiteKey();
    if (!captchaKey) return "dev-bypass";
    const turnstileEl = form?.querySelector<HTMLElement>(".cf-turnstile");
    if (turnstileEl && "turnstile" in window) {
      const w = window as Window & { turnstile?: { getResponse: (el?: HTMLElement) => string } };
      return w.turnstile?.getResponse(turnstileEl) || "";
    }
    if (typeof grecaptcha !== "undefined") {
      return grecaptcha.getResponse() || "";
    }
    return "";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const api = await resolveApiBaseUrl();
    if (!api) {
      showAlert("Application form is temporarily unavailable. Please try again later.", "error");
      return;
    }

    const captchaKey = await resolveCaptchaSiteKey();
    const captchaToken = await getCaptchaToken();
    if (captchaKey && !captchaToken) {
      showAlert("Please complete the security check below.", "error");
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    const fd = new FormData(form);
    const { firstName, lastName } = splitName(fd.get("fullName"));
    const customFields: Record<string, string> = {};

    for (const [k, v] of fd.entries()) {
      if (!["fullName", "email", "phone", "website", "movingExperience"].includes(k)) {
        customFields[k] = String(v);
      }
    }
    if (fd.get("movingExperience")) customFields.movingExperience = "yes";
    if (fd.get("interest")) customFields.primaryInterest = String(fd.get("interest"));

    const body = {
      officeSlug: form.dataset.officeSlug,
      jobSlug: form.dataset.jobSlug,
      firstName,
      lastName,
      email: fd.get("email"),
      phone: fd.get("phone"),
      captchaToken,
      honeypot: fd.get("website") || "",
      customFields,
    };

    try {
      const res = await fetch(`${api}/applications`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Submission failed");

      form.hidden = true;
      if (typeof grecaptcha !== "undefined") grecaptcha.reset();
      const w = window as Window & { turnstile?: { reset: (el?: HTMLElement) => void } };
      const turnstileEl = document.querySelector(".cf-turnstile");
      if (w.turnstile && turnstileEl) w.turnstile.reset(turnstileEl as HTMLElement);

      showAlert(
        "Thank you! Check your phone and email for instructions. We'll be in touch shortly to discuss your application.",
        "success"
      );
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch (err) {
      showAlert(
        err instanceof Error ? err.message : "Oops! Something went wrong. Check all fields and try again.",
        "error"
      );
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
