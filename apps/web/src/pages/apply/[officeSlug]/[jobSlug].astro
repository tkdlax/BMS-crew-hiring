---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import ApplyHeroShell from "../../../components/apply/ApplyHeroShell.astro";
import VideoGallery from "../../../components/apply/VideoGallery.astro";
import JobDetailsCard from "../../../components/apply/JobDetailsCard.astro";
import TrustStrip from "../../../components/TrustStrip.astro";
import { BRAND } from "../../../constants/brand";
import { OPERATIONS_JOB_SLUG, LEGACY_JOB_SLUGS } from "../../../constants/jobs";
import { OPERATIONS_OFFICE_ORDER } from "../../../constants/offices";
import { isKnownOperationsOffice, mergeJobPageContent } from "../../../lib/jobPageContent";
import { officeDisplayName } from "../../../lib/openings";
import {
  getApiBaseUrl,
  getRuntimeApiBaseUrl,
  getRuntimeCaptchaSiteKey,
} from "../../../lib/api";
import { hrefPath } from "../../../lib/assets";
import { ogImageForOffice } from "../../../constants/images";
import { applyPageSeo } from "../../../lib/seo";
import { resolveCaptchaProvider } from "../../../lib/captcha";

export async function getStaticPaths() {
  const api = getApiBaseUrl();
  const fallback = OPERATIONS_OFFICE_ORDER.map((officeSlug) => ({
    params: { officeSlug, jobSlug: OPERATIONS_JOB_SLUG },
  }));

  if (!api) return fallback;

  try {
    const res = await fetch(`${api}/public/openings`);
    if (!res.ok) return fallback;
    const { openings } = await res.json();
    if (!openings?.length) return fallback;
    return openings
      .filter((o: { job_slug: string }) => !LEGACY_JOB_SLUGS.includes(o.job_slug as typeof LEGACY_JOB_SLUGS[number]))
      .map((o: { office_slug: string; job_slug: string }) => ({
        params: { officeSlug: o.office_slug, jobSlug: o.job_slug },
      }));
  } catch {
    return fallback;
  }
}

const { officeSlug, jobSlug } = Astro.params;
const api = getRuntimeApiBaseUrl(Astro.locals);
const captchaKey = getRuntimeCaptchaSiteKey(Astro.locals);
const captchaProviderNorm = resolveCaptchaProvider(
  captchaKey,
  (Astro.locals.runtime?.env?.PUBLIC_CAPTCHA_PROVIDER as string) ||
    (Astro.locals.runtime?.env?.CAPTCHA_PROVIDER as string) ||
    import.meta.env.PUBLIC_CAPTCHA_PROVIDER
);

const privacyUrl = `${BRAND.mainSite}/privacy-policy`;
const operationsUrl = hrefPath("operations/");

const knownOpsApply =
  Boolean(officeSlug && jobSlug === OPERATIONS_JOB_SLUG && isKnownOperationsOffice(officeSlug!));

let job: Record<string, unknown> | null = null;
let officeLocationLabel = "";
let loadError = "";

if (api && officeSlug) {
  try {
    const ores = await fetch(`${api}/public/offices/${officeSlug}`);
    if (ores.ok) {
      const office = await ores.json();
      officeLocationLabel = office.locationLabel ? String(office.locationLabel) : "";
    }
  } catch {
    /* job fetch may still supply location */
  }

  try {
    const res = await fetch(`${api}/public/jobs/${officeSlug}/${jobSlug}`);
    if (res.ok) job = await res.json();
    else if (!knownOpsApply) {
      loadError = res.status === 404 ? "This position is not available." : "Unable to load job.";
    }
  } catch {
    if (!knownOpsApply) loadError = "Unable to connect. Please try again later.";
  }
} else if (!knownOpsApply) {
  loadError = "Unable to connect. Please try again later.";
}

const locationLabel =
  officeLocationLabel ||
  (job?.locationLabel ? String(job.locationLabel) : "");

const pageContent =
  officeSlug && jobSlug
    ? mergeJobPageContent(officeSlug, jobSlug, job?.pageContent as Record<string, unknown>, {
        title: job?.title ? String(job.title) : "Moving Operations Crew",
        officeName: job?.officeName ? String(job.officeName) : officeDisplayName(officeSlug),
        locationLabel,
        payMinHourly: job?.payMinHourly != null ? Number(job.payMinHourly) : null,
        payMaxHourly: job?.payMaxHourly != null ? Number(job.payMaxHourly) : null,
      })
    : null;

const showApply = Boolean(pageContent && (job || knownOpsApply));

const applySeo = pageContent
  ? applyPageSeo({
      headline: pageContent.headline ?? "Apply",
      heroLead: pageContent.heroLead,
      officeName:
        (job?.officeName ? String(job.officeName) : null) ||
        (officeSlug ? officeDisplayName(officeSlug) : null),
      ogImage: officeSlug ? ogImageForOffice(officeSlug, pageContent.heroImage) : undefined,
      pathname: Astro.url.pathname,
    })
  : {
      title: "Apply",
      pathname: Astro.url.pathname,
    };
---

<BaseLayout
  title={applySeo.title}
  description={applySeo.description}
  ogImage={applySeo.ogImage}
  ogImageAlt={applySeo.ogImageAlt}
  bodyClass="page-apply"
  applyChrome
>
  {loadError ? (
    <>
      <section class="page-band">
        <div class="page-band__inner">
          <h1>Position unavailable</h1>
          <p class="sub">{loadError}</p>
        </div>
      </section>
      <div class="page-wrap">
        <a href={operationsUrl} class="btn btn-secondary">Back to operations openings</a>
      </div>
    </>
  ) : showApply && pageContent ? (
    <>
      <ApplyHeroShell
        content={pageContent}
        officeSlug={officeSlug!}
        jobSlug={jobSlug!}
        captchaSiteKey={captchaKey}
        captchaProvider={captchaProviderNorm}
        privacyUrl={privacyUrl}
      />

      <TrustStrip />

      {pageContent.videos && pageContent.videos.length > 0 && pageContent.learnSectionTitle && (
        <VideoGallery title={pageContent.learnSectionTitle} videos={pageContent.videos} />
      )}

      {pageContent.jobDetails && (
        <section class="apply-details-section page-wrap">
          <JobDetailsCard details={pageContent.jobDetails} />
        </section>
      )}
    </>
  ) : (
    <div class="page-wrap">
      <p class="lead">Loading position details…</p>
    </div>
  )}
</BaseLayout>

{captchaProviderNorm === "recaptcha" && (
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
)}
{captchaKey && captchaProviderNorm === "turnstile" && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  import { resolveApiBaseUrl, resolveCaptchaProviderFromConfig, resolveCaptchaSiteKey, resolveHireApiBaseUrl } from "../../../lib/api.client.ts";
  import { getRecaptchaResponse, mountRecaptchaWidget } from "../../../lib/recaptcha.client.ts";

  function formatLocationLines(address: string): string[] {
    const trimmed = address.trim();
    if (!trimmed) return [];
    if (trimmed.includes("\n")) return trimmed.split("\n").map((l) => l.trim()).filter(Boolean);
    const comma = trimmed.indexOf(",");
    if (comma > 0 && comma < trimmed.length - 1) {
      return [trimmed.slice(0, comma).trim(), trimmed.slice(comma + 1).trim()];
    }
    return [trimmed];
  }

  async function hydrateOfficeLocation() {
    const officeSlug = document.querySelector<HTMLElement>("[data-office-slug]")?.dataset.officeSlug;
    if (!officeSlug) return;
    const api = await resolveApiBaseUrl();
    if (!api) return;

    let locationLabel = "";
    try {
      const res = await fetch(`${api}/public/offices/${officeSlug}`);
      if (!res.ok) return;
      const office = await res.json();
      locationLabel = String(office.locationLabel ?? "").trim();
    } catch {
      return;
    }
    if (!locationLabel) return;

    const addressEl = document.querySelector("[data-apply-address]");
    if (addressEl && addressEl.textContent?.trim() !== locationLabel) {
      addressEl.textContent = locationLabel;
    }

    const commute = document.querySelector<HTMLAnchorElement>("[data-apply-commute]");
    if (commute) {
      commute.href = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(locationLabel)}`;
    }

    const detailsLoc = document.querySelector("[data-apply-details-location]");
    if (detailsLoc) {
      const lines = formatLocationLines(locationLabel);
      detailsLoc.innerHTML = lines.map((line) => `${line}<br />`).join("");
    }
  }

  hydrateOfficeLocation();

  const form = document.getElementById("apply-form") as HTMLFormElement | null;
  const alertEl = document.getElementById("form-alert");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  function showAlert(msg: string, type: "error" | "success") {
    if (!alertEl) return;
    alertEl.hidden = false;
    alertEl.className = `form-alert alert alert-${type}`;
    alertEl.textContent = msg;
    alertEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function splitName(full: unknown) {
    const parts = String(full || "")
      .trim()
      .split(/\s+/)
      .filter(Boolean);
    if (!parts.length) return { firstName: "", lastName: "" };
    if (parts.length === 1) return { firstName: parts[0]!, lastName: parts[0]! };
    return { firstName: parts[0]!, lastName: parts.slice(1).join(" ") };
  }

  let recaptchaWidgetId: number | null = null;
  let recaptchaToken = "";

  function resetCaptchaWidgets() {
    recaptchaToken = "";
    if (typeof grecaptcha !== "undefined") {
      if (recaptchaWidgetId != null) grecaptcha.reset(recaptchaWidgetId);
      else grecaptcha.reset();
    }
    const w = window as Window & { turnstile?: { reset: (el?: HTMLElement) => void } };
    const turnstileEl = document.querySelector(".cf-turnstile");
    if (w.turnstile && turnstileEl) w.turnstile.reset(turnstileEl as HTMLElement);
  }

  async function ensureRecaptchaMount(): Promise<HTMLElement | null> {
    let mount = document.getElementById("recaptcha-root");
    if (mount) return mount;

    const provider = await resolveCaptchaProviderFromConfig();
    if (provider !== "recaptcha" || !form) return null;

    let wrap = form.querySelector(".captcha-wrap");
    if (!wrap) {
      wrap = document.createElement("div");
      wrap.className = "form-group captcha-wrap";
      wrap.setAttribute("data-captcha-provider", "recaptcha");
      submitBtn?.parentNode?.insertBefore(wrap, submitBtn);
    }

    mount = document.createElement("div");
    mount.id = "recaptcha-root";
    mount.className = "recaptcha-mount";
    wrap.appendChild(mount);
    return mount;
  }

  async function initRecaptchaWidget() {
    const mount = await ensureRecaptchaMount();
    if (!mount || mount.dataset.rendered === "true") return;

    const captchaKey =
      mount.dataset.sitekey?.trim() || (await resolveCaptchaSiteKey());
    const provider = await resolveCaptchaProviderFromConfig();
    if (!captchaKey || provider !== "recaptcha") return;

    mount.dataset.sitekey = captchaKey;

    try {
      const widgetId = await mountRecaptchaWidget({
        mount,
        sitekey: captchaKey,
        onToken: (token) => {
          recaptchaToken = token;
        },
        onExpire: () => {
          recaptchaToken = "";
        },
        onError: () => {
          recaptchaToken = "";
        },
      });
      if (widgetId != null) recaptchaWidgetId = widgetId;
      mount.dataset.rendered = "true";
    } catch {
      showAlert("Security verification failed to load. Please refresh the page.", "error");
    }
  }

  initRecaptchaWidget();

  async function getCaptchaToken() {
    const captchaKey = await resolveCaptchaSiteKey();
    if (!captchaKey) return "dev-bypass";
    const provider = await resolveCaptchaProviderFromConfig();
    if (provider === "recaptcha") {
      const mount = document.getElementById("recaptcha-root");
      return getRecaptchaResponse(mount, recaptchaWidgetId, recaptchaToken);
    }
    const turnstileEl = form?.querySelector<HTMLElement>(".cf-turnstile");
    if (turnstileEl && "turnstile" in window) {
      const w = window as Window & { turnstile?: { getResponse: (el?: HTMLElement) => string } };
      return w.turnstile?.getResponse(turnstileEl) || "";
    }
    return "";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const api = await resolveHireApiBaseUrl();
    if (!api) {
      showAlert("Application form is temporarily unavailable. Please try again later.", "error");
      return;
    }

    const captchaKey = await resolveCaptchaSiteKey();
    const captchaToken = await getCaptchaToken();
    const captchaProvider = await resolveCaptchaProviderFromConfig();
    if (captchaKey && !captchaToken) {
      showAlert("Please complete the security check below.", "error");
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    const fd = new FormData(form);
    const { firstName, lastName } = splitName(fd.get("fullName"));
    const customFields: Record<string, string> = {};

    for (const [k, v] of fd.entries()) {
      if (!["fullName", "email", "phone", "website", "movingExperience"].includes(k)) {
        customFields[k] = String(v);
      }
    }
    if (fd.get("movingExperience")) customFields.movingExperience = "yes";
    if (fd.get("interest")) customFields.primaryInterest = String(fd.get("interest"));

    const email = String(fd.get("email") ?? "").trim();
    const phone = String(fd.get("phone") ?? "").trim();
    if (!email) {
      showAlert("Please enter your email address.", "error");
      return;
    }

    const body = {
      officeSlug: form.dataset.officeSlug,
      jobSlug: form.dataset.jobSlug,
      firstName,
      lastName,
      email,
      phone,
      captchaToken,
      captchaProvider: captchaKey ? captchaProvider : undefined,
      honeypot: fd.get("website") || "",
      customFields,
    };

    try {
      const res = await fetch(`${api}/applications`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Submission failed");

      form.hidden = true;
      resetCaptchaWidgets();

      showAlert(
        "Thank you! Check your phone and email for instructions. We'll be in touch shortly to discuss your application.",
        "success"
      );
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch (err) {
      const msg = err instanceof Error ? err.message : "Oops! Something went wrong. Check all fields and try again.";
      showAlert(msg, "error");
      resetCaptchaWidgets();
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
