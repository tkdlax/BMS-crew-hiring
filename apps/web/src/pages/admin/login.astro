---
import AdminLayout from "../../layouts/AdminLayout.astro";

const api = import.meta.env.PUBLIC_API_BASE_URL;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<AdminLayout title="Admin sign in">
  <div class="admin-card" style="max-width: 24rem;">
    <h1>Admin sign in</h1>
    <div id="login-alert" hidden class="alert alert-error" style="display: none;"></div>
    <form id="login-form" class="admin-form">
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" />
      </div>
      <button type="submit" class="btn">Sign in</button>
    </form>
  </div>
</AdminLayout>

<script define:vars={{ api, base }}>
  document.getElementById("login-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const password = new FormData(e.target).get("password");
    const res = await fetch(`${api}/admin/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "include",
      body: JSON.stringify({ password }),
    });
    const alertEl = document.getElementById("login-alert");
    if (res.ok) {
      location.href = `${base}admin/`;
      return;
    }
    const data = await res.json().catch(() => ({}));
    if (alertEl) {
      alertEl.style.display = "block";
      alertEl.textContent = data.error || "Invalid password";
    }
  });
</script>
