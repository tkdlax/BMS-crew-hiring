---
import BaseLayout from "../../layouts/BaseLayout.astro";
const api = import.meta.env.PUBLIC_API_BASE_URL;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Admin login">
  <div class="card">
    <h1>Admin sign in</h1>
    <div id="login-alert" hidden></div>
    <form id="login-form" class="admin-form">
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" />
      </div>
      <button type="submit" class="btn btn-primary">Sign in</button>
    </form>
  </div>
  <link rel="stylesheet" href={`${base}styles/admin.css`} />
</BaseLayout>

<script define:vars={{ api, base }}>
  document.getElementById("login-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const password = new FormData(e.target).get("password");
    const res = await fetch(`${api}/admin/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "include",
      body: JSON.stringify({ password }),
    });
    const alertEl = document.getElementById("login-alert");
    if (res.ok) {
      location.href = `${base}admin/`;
      return;
    }
    const data = await res.json().catch(() => ({}));
    alertEl.hidden = false;
    alertEl.className = "alert alert-error";
    alertEl.textContent = data.error || "Invalid password";
  });
</script>
