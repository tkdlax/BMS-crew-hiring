---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { hrefPath } from "../../lib/assets";

const adminHome = hrefPath("admin/");
---
<AdminLayout title="Admin sign in" requireAuth={false} showNav={false}>
  <div class="admin-login-wrap">
    <div class="admin-card admin-login-card">
      <h1>Sign in</h1>
      <p class="admin-login-lead">Bailey&apos;s operations hiring admin</p>
      <div id="login-alert" hidden class="alert alert-error"></div>
      <form id="login-form" class="admin-form">
        <div class="field">
          <label for="username">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            autocomplete="username"
            placeholder="admin"
          />
          <p class="field-hint">Not used for sign-in — password only.</p>
        </div>
        <div class="field hp" aria-hidden="true">
          <label for="login-website">Website</label>
          <input id="login-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn--block" id="login-submit" disabled>Sign in</button>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { enableLoginWhenApiReady } from "../../lib/api.client.ts";

  const adminHome = document.documentElement.dataset.adminHome!;

  enableLoginWhenApiReady("login-form", "#login-submit").then(() => {
    document.getElementById("login-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const { resolveAdminApiBaseUrl } = await import("../../lib/api.client.ts");
      const api = await resolveAdminApiBaseUrl();
      if (!api) return;

      const form = e.target as HTMLFormElement;
      const fd = new FormData(form);
      const alertEl = document.getElementById("login-alert");
      const submitBtn = document.getElementById("login-submit") as HTMLButtonElement;

      const honeypot = String(fd.get("website") ?? "").trim();
      if (honeypot) {
        if (alertEl) {
          alertEl.hidden = false;
          alertEl.textContent = "Invalid password";
        }
        return;
      }

      submitBtn.disabled = true;
      try {
        const res = await fetch(`${api}/login`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({
            password: fd.get("password"),
            username: fd.get("username"),
            honeypot: "",
          }),
        });
        if (res.ok) {
          location.href = adminHome;
          return;
        }
        const data = await res.json().catch(() => ({}));
        if (alertEl) {
          alertEl.hidden = false;
          alertEl.textContent = (data as { error?: string }).error || "Invalid password";
        }
      } catch {
        if (alertEl) {
          alertEl.hidden = false;
          alertEl.textContent = "Could not reach the server. Try again in a moment.";
        }
      } finally {
        submitBtn.disabled = false;
      }
    });
  });
</script>
