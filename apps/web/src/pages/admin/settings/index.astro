---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---
<AdminLayout title="Settings" activeNav="settings">
  <div class="admin-card">
    <h1>Global schedule settings</h1>
    <form id="settings-form" class="admin-form">
      <div class="field"><label>Slot duration (minutes)</label><input name="slotDurationMinutes" type="number" min="15" /></div>
      <div class="field"><label>Buffer around booked slots (minutes)</label><input name="bufferMinutes" type="number" min="0" /></div>
      <p class="admin-hint">Prevents back-to-back bookings overlapping a reserved slot. Does not add gaps between open times on the calendar.</p>
      <div class="field"><label>Booking window (days ahead)</label><input name="bookingWindowDays" type="number" min="1" max="90" /></div>
      <div class="field"><label>Minimum notice (hours)</label><input name="minNoticeHours" type="number" min="0" /></div>
      <div class="field"><label>Quiet hours start (HH:mm)</label><input name="quietHoursStart" /></div>
      <div class="field"><label>Quiet hours end (HH:mm)</label><input name="quietHoursEnd" /></div>
      <div class="field"><label>Token expiry (days)</label><input name="tokenExpiryDays" type="number" /></div>
      <div class="field"><label>Reminder offsets (JSON)</label><textarea name="reminderOffsetsJson" rows="4"></textarea></div>
      <div class="field"><label><input type="checkbox" name="smsOnInvite" /> SMS on invite</label></div>
      <button type="submit" class="btn">Save schedule settings</button>
    </form>
    <p id="save-msg" class="admin-hint"></p>
  </div>

  <div class="admin-card">
    <h1>Manager webhooks</h1>
    <p class="admin-hint">
      Each office can use different URLs for new applications vs. scheduled interviews (e.g. Zapier, Slack).
      Leave blank to skip that notification for an office.
    </p>
    <div id="webhooks-table">Loading…</div>
    <button type="button" class="btn" id="save-webhooks" style="margin-top: 1rem">Save webhooks</button>
    <p id="webhook-msg" class="admin-hint"></p>
  </div>
</AdminLayout>

<style>
  .admin-hint { color: var(--text-light); font-size: 0.875rem; }
  .webhook-url-input {
    width: 100%;
    min-width: 12rem;
    padding: 0.5rem 0.625rem;
    font-size: 0.8125rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: inherit;
  }
</style>

<script>
  import { resolveAdminApiBaseUrl } from "../../../lib/api.client.ts";

  type OfficeWebhooks = {
    id: number;
    name: string;
    slug: string;
    webhooks: Record<string, string>;
  };

  let officeWebhooks: OfficeWebhooks[] = [];

  async function loadSchedule(api: string) {
    const res = await fetch(`${api}/schedule-config?scope=global`, { credentials: "include" });
    const { config: c } = await res.json();
    if (!c) return;
    const f = document.getElementById("settings-form") as HTMLFormElement;
    (f.elements.namedItem("slotDurationMinutes") as HTMLInputElement).value = String(
      c.slot_duration_minutes
    );
    (f.elements.namedItem("bufferMinutes") as HTMLInputElement).value = String(c.buffer_minutes);
    (f.elements.namedItem("bookingWindowDays") as HTMLInputElement).value = String(
      c.booking_window_days ?? 7
    );
    (f.elements.namedItem("minNoticeHours") as HTMLInputElement).value = String(
      c.min_notice_hours ?? 8
    );
    (f.elements.namedItem("quietHoursStart") as HTMLInputElement).value = c.quiet_hours_start;
    (f.elements.namedItem("quietHoursEnd") as HTMLInputElement).value = c.quiet_hours_end;
    (f.elements.namedItem("tokenExpiryDays") as HTMLInputElement).value = String(
      c.token_expiry_days
    );
    (f.elements.namedItem("reminderOffsetsJson") as HTMLTextAreaElement).value =
      c.reminder_offsets_json;
    (f.elements.namedItem("smsOnInvite") as HTMLInputElement).checked = c.sms_on_invite;
  }

  function renderWebhooksTable() {
    const el = document.getElementById("webhooks-table")!;
    if (!officeWebhooks.length) {
      el.innerHTML = "<p>No offices found.</p>";
      return;
    }
    el.innerHTML = `<table class="data"><thead><tr><th>Office</th><th>New application submitted</th><th>Interview scheduled</th><th>Interview rescheduled</th></tr></thead><tbody>${officeWebhooks
      .map(
        (o) => `<tr>
          <td><strong>${o.name}</strong><br><span class="admin-hint">${o.slug}</span></td>
          <td><input class="webhook-url-input" type="url" data-office-id="${o.id}" data-event="application_submitted" value="${esc(o.webhooks.application_submitted || "")}" placeholder="https://hooks.zapier.com/..." /></td>
          <td><input class="webhook-url-input" type="url" data-office-id="${o.id}" data-event="interview_scheduled" value="${esc(o.webhooks.interview_scheduled || "")}" placeholder="https://hooks.zapier.com/..." /></td>
          <td><input class="webhook-url-input" type="url" data-office-id="${o.id}" data-event="interview_rescheduled" value="${esc(o.webhooks.interview_rescheduled || "")}" placeholder="https://hooks.zapier.com/..." /></td>
        </tr>`
      )
      .join("")}</tbody></table>`;
  }

  function esc(s: string) {
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/"/g, "&quot;")
      .replace(/</g, "&lt;");
  }

  async function loadWebhooks(api: string) {
    const res = await fetch(`${api}/webhooks`, { credentials: "include" });
    const data = await res.json();
    officeWebhooks = data.offices as OfficeWebhooks[];
    renderWebhooksTable();
  }

  document.getElementById("settings-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const api = await resolveAdminApiBaseUrl();
    if (!api) return;
    const fd = new FormData(e.target as HTMLFormElement);
    await fetch(`${api}/schedule-config`, {
      method: "PUT",
      credentials: "include",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        scope: "global",
        scopeId: null,
        slotDurationMinutes: parseInt(String(fd.get("slotDurationMinutes")), 10),
        bufferMinutes: parseInt(String(fd.get("bufferMinutes")), 10),
        bookingWindowDays: parseInt(String(fd.get("bookingWindowDays")), 10),
        minNoticeHours: parseInt(String(fd.get("minNoticeHours")), 10),
        quietHoursStart: fd.get("quietHoursStart"),
        quietHoursEnd: fd.get("quietHoursEnd"),
        tokenExpiryDays: parseInt(String(fd.get("tokenExpiryDays")), 10),
        reminderOffsetsJson: fd.get("reminderOffsetsJson"),
        smsOnInvite: fd.get("smsOnInvite") === "on",
      }),
    });
    document.getElementById("save-msg")!.textContent = "Schedule settings saved.";
  });

  document.getElementById("save-webhooks")?.addEventListener("click", async () => {
    const api = await resolveAdminApiBaseUrl();
    if (!api) return;
    const inputs = document.querySelectorAll(
      ".webhook-url-input"
    ) as NodeListOf<HTMLInputElement>;
    const byOffice = new Map<
      number,
      {
        application_submitted?: string;
        interview_scheduled?: string;
        interview_rescheduled?: string;
      }
    >();
    inputs.forEach((input) => {
      const id = parseInt(input.dataset.officeId!, 10);
      const event = input.dataset.event as
        | "application_submitted"
        | "interview_scheduled"
        | "interview_rescheduled";
      if (!byOffice.has(id)) byOffice.set(id, {});
      const entry = byOffice.get(id)!;
      const val = input.value.trim();
      if (val) entry[event] = val;
    });
    const offices = [...byOffice.entries()].map(([officeId, webhooks]) => ({
      officeId,
      webhooks,
    }));
    const res = await fetch(`${api}/webhooks`, {
      method: "PUT",
      credentials: "include",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ offices }),
    });
    document.getElementById("webhook-msg")!.textContent = res.ok
      ? "Webhooks saved."
      : "Save failed — check URLs and try again.";
    if (res.ok) loadWebhooks(api);
  });

  (async () => {
    await window.adminAuthCheck;
    const api = await resolveAdminApiBaseUrl();
    if (!api) return;
    await loadSchedule(api);
    await loadWebhooks(api);
  })();
</script>
