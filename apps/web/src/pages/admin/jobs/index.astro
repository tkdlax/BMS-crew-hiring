---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---
<AdminLayout title="Jobs" activeNav="jobs">
  <div class="admin-card">
    <h1>Jobs</h1>
    <div class="filters">
      <label>Office
        <select id="filter-office"><option value="">All</option></select>
      </label>
    </div>
    <div id="jobs-table">Loading…</div>
    <div id="job-edit-host"></div>
    <h2>Add job</h2>
    <form id="job-form" class="admin-form">
      <div class="field"><label>Office</label><select name="officeId" id="office-select" required></select></div>
      <div class="field"><label>Slug</label><input name="slug" required pattern="[a-z0-9-]+" /></div>
      <div class="field"><label>Title</label><input name="title" required /></div>
      <div class="field"><label>Pay min ($/hr)</label><input name="payMinHourly" type="number" min="0" max="999" step="0.01" value="17" /></div>
      <div class="field"><label>Pay max ($/hr)</label><input name="payMaxHourly" type="number" min="0" max="999" step="0.01" value="25" /></div>
      <div class="field"><label>Headline (apply page)</label><input name="headline" /></div>
      <div class="field"><label>Address override (apply page)</label><input name="address" placeholder="Leave blank to use office address" /></div>
      <div class="field"><label>Description (apply page)</label><textarea name="description"></textarea></div>
      <button type="submit" class="btn">Create job</button>
    </form>
  </div>
</AdminLayout>

<script>
  import { resolveAdminApiBaseUrl } from "../../../lib/api.client.ts";

  function esc(s) {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/"/g, "&quot;");
  }

  function parsePageContent(job) {
    const raw = job.page_content;
    if (!raw) return {};
    if (typeof raw === "object") return raw;
    try {
      return JSON.parse(raw);
    } catch {
      return {};
    }
  }

  function buildPageContent(fd, existing = {}) {
    const address = String(fd.get("address") ?? "").trim();
    const pageContent = {
      ...existing,
      headline: fd.get("headline") || fd.get("title"),
      description: fd.get("description") || "",
    };
    if (address) {
      pageContent.address = address;
      pageContent.addressOverride = true;
    } else {
      delete pageContent.address;
      delete pageContent.addressOverride;
    }
    return pageContent;
  }

  function parsePayFields(fd) {
    const minStr = String(fd.get("payMinHourly") ?? "").trim();
    const maxStr = String(fd.get("payMaxHourly") ?? "").trim();
    return {
      payMinHourly: minStr ? parseFloat(minStr) : null,
      payMaxHourly: maxStr ? parseFloat(maxStr) : null,
    };
  }

  function formatPayCell(j) {
    const min = j.pay_min_hourly ?? j.payMinHourly;
    const max = j.pay_max_hourly ?? j.payMaxHourly;
    if (min == null || max == null) return "—";
    return `$${min}–$${max}/hr`;
  }

  let offices = [];
  let jobs = [];

  function renderTable() {
    const el = document.getElementById("jobs-table");
    if (!jobs.length) {
      el.innerHTML = "<p>No jobs yet.</p>";
      return;
    }
    el.innerHTML = `<table class="data"><thead><tr><th>Title</th><th>Office</th><th>Pay</th><th>Slug</th><th>Apply URL</th><th>Active</th><th></th></tr></thead><tbody>${jobs
      .map(
        (j) =>
          `<tr><td>${esc(j.title)}</td><td>${esc(j.office_name)}</td><td>${formatPayCell(j)}</td><td>${esc(j.slug)}</td><td><a href="${esc(j.applyUrl)}" target="_blank" rel="noopener">Open</a></td><td>${j.active ? "Yes" : "No"}</td><td class="table-actions"><button type="button" class="btn btn-small btn-secondary" data-edit="${j.id}">Edit</button></td></tr>`
      )
      .join("")}</tbody></table>`;
    el.querySelectorAll("[data-edit]").forEach((btn) => {
      btn.addEventListener("click", () => openEdit(parseInt(btn.getAttribute("data-edit")!, 10)));
    });
  }

  function openEdit(id) {
    const j = jobs.find((x) => x.id === id);
    if (!j) return;
    const page = parsePageContent(j);
    const officeOptions = offices
      .map((o) => `<option value="${o.id}" ${o.id === j.office_id ? "selected" : ""}>${esc(o.name)}</option>`)
      .join("");
    const host = document.getElementById("job-edit-host");
    host.innerHTML = `
      <div class="admin-edit-panel" id="job-edit-panel">
        <h3>Edit job: ${esc(j.title)}</h3>
        <form id="job-edit-form" class="admin-form">
          <div class="field"><label>Office</label><select name="officeId" required>${officeOptions}</select></div>
          <div class="field"><label>Slug</label><input name="slug" required pattern="[a-z0-9-]+" value="${esc(j.slug)}" /></div>
          <div class="field"><label>Title</label><input name="title" required value="${esc(j.title)}" /></div>
          <div class="field"><label>Pay min ($/hr)</label><input name="payMinHourly" type="number" min="0" max="999" step="0.01" value="${esc(j.pay_min_hourly ?? j.payMinHourly ?? 17)}" /></div>
          <div class="field"><label>Pay max ($/hr)</label><input name="payMaxHourly" type="number" min="0" max="999" step="0.01" value="${esc(j.pay_max_hourly ?? j.payMaxHourly ?? 25)}" /></div>
          <div class="field"><label>Headline (apply page)</label><input name="headline" value="${esc(page.headline ?? "")}" /></div>
          <div class="field"><label>Address override (apply page)</label><input name="address" value="${esc(page.addressOverride ? page.address ?? "" : "")}" placeholder="Leave blank to use office address" /></div>
          <div class="field"><label>Description (apply page)</label><textarea name="description">${esc(page.description ?? "")}</textarea></div>
          <div class="field"><label><input type="checkbox" name="active" ${j.active ? "checked" : ""} /> Active</label></div>
          <div class="table-actions">
            <button type="submit" class="btn">Save changes</button>
            <button type="button" class="btn btn-secondary" id="job-edit-cancel">Cancel</button>
          </div>
        </form>
        <p id="job-edit-msg"></p>
      </div>`;
    host.scrollIntoView({ behavior: "smooth", block: "nearest" });
    document.getElementById("job-edit-cancel")?.addEventListener("click", () => {
      host.innerHTML = "";
    });
    document.getElementById("job-edit-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const api = await resolveAdminApiBaseUrl();
      if (!api) return;
      const fd = new FormData(e.target);
      const existing = parsePageContent(j);
      const formFields = Array.isArray(j.form_fields)
        ? j.form_fields
        : typeof j.form_fields === "string"
          ? JSON.parse(j.form_fields || "[]")
          : [];
      const pageContent = buildPageContent(fd, existing);

      const res = await fetch(`${api}/jobs/${id}`, {
        method: "PUT",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          officeId: parseInt(fd.get("officeId"), 10),
          slug: fd.get("slug"),
          title: fd.get("title"),
          active: fd.get("active") === "on",
          ...parsePayFields(fd),
          pageContent,
          formFields,
        }),
      });
      const msg = document.getElementById("job-edit-msg");
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        if (msg) msg.textContent = (data as { error?: string }).error || "Save failed.";
        return;
      }
      if (msg) msg.textContent = "Saved.";
      host.innerHTML = "";
      await loadJobs(api);
    });
  }

  async function loadOffices(api) {
    const res = await fetch(`${api}/offices`, { credentials: "include" });
    const data = await res.json();
    offices = data.offices;
    const sel = document.getElementById("office-select");
    const filt = document.getElementById("filter-office");
    sel.innerHTML = "";
    filt.innerHTML = '<option value="">All</option>';
    offices.forEach((o) => {
      sel.innerHTML += `<option value="${o.id}">${esc(o.name)}</option>`;
      filt.innerHTML += `<option value="${o.id}">${esc(o.name)}</option>`;
    });
  }

  async function loadJobs(api) {
    const officeId = document.getElementById("filter-office").value;
    const q = officeId ? `?officeId=${officeId}` : "";
    const res = await fetch(`${api}/jobs${q}`, { credentials: "include" });
    const data = await res.json();
    jobs = data.jobs;
    renderTable();
  }

  document.getElementById("filter-office")?.addEventListener("change", async () => {
    const api = await resolveAdminApiBaseUrl();
    if (api) await loadJobs(api);
  });

  document.getElementById("job-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const api = await resolveAdminApiBaseUrl();
    if (!api) return;
    const fd = new FormData(e.target);
    await fetch(`${api}/jobs`, {
      method: "POST",
      credentials: "include",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        officeId: parseInt(fd.get("officeId"), 10),
        slug: fd.get("slug"),
        title: fd.get("title"),
        active: true,
        ...parsePayFields(fd),
        pageContent: buildPageContent(fd),
        formFields: [],
      }),
    });
    e.target.reset();
    loadJobs(api);
  });

  (async () => {
    await window.adminAuthCheck;
    const api = await resolveAdminApiBaseUrl();
    if (!api) return;
    await loadOffices(api);
    await loadJobs(api);
  })();
</script>

<style>
  .muted {
    color: var(--text-light);
    font-size: 0.8125rem;
  }
</style>
