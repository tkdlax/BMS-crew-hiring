---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { hrefPath } from "../../lib/assets";

const api = import.meta.env.PUBLIC_API_BASE_URL;
const loginPath = hrefPath("admin/login/");
---
<AdminLayout title="Dashboard">
  <div class="admin-card">
    <h1>Hiring admin</h1>
    <p>Manage offices, jobs, applications, templates, and scheduling settings.</p>
    <ul>
      <li><a href={hrefPath("admin/offices/")}>Offices</a></li>
      <li><a href={hrefPath("admin/jobs/")}>Jobs</a></li>
      <li><a href={hrefPath("admin/applications/")}>Applications</a></li>
      <li><a href={hrefPath("admin/templates/")}>Message templates</a></li>
      <li><a href={hrefPath("admin/settings/")}>Global schedule settings</a></li>
    </ul>
  </div>
</AdminLayout>

<script define:vars={{ api, loginPath }}>
  fetch(`${api}/admin/session`, { credentials: "include" })
    .then((r) => r.json())
    .then((d) => {
      if (!d.authenticated) location.href = loginPath;
    });
</script>
