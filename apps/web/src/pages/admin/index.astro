---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { hrefPath } from "../../lib/assets";
---
<AdminLayout title="Dashboard">
  <div class="admin-card">
    <h1>Hiring admin</h1>
    <p>Manage offices, jobs, applications, templates, and scheduling settings.</p>
    <ul>
      <li><a href={hrefPath("admin/offices/")}>Offices</a></li>
      <li><a href={hrefPath("admin/jobs/")}>Jobs</a></li>
      <li><a href={hrefPath("admin/applications/")}>Applications</a></li>
      <li><a href={hrefPath("admin/templates/")}>Message templates</a></li>
      <li><a href={hrefPath("admin/scheduling/")}>Office scheduling (hours)</a></li>
      <li><a href={hrefPath("admin/settings/")}>Global schedule &amp; webhooks</a></li>
      <li><a href={hrefPath("schedule/preview/")} target="_blank" rel="noopener">Schedule calendar preview (test)</a></li>
    </ul>
  </div>
</AdminLayout>
