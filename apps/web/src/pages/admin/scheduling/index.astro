---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { hrefPath } from "../../../lib/assets";

const previewBase = hrefPath("schedule/preview/");
---
<AdminLayout title="Office availability" activeNav="availability">
  <div class="admin-card">
    <h1>Office scheduling</h1>
    <p>Set weekly interview hours and booking rules per office (like Calendly availability).</p>
    <div class="field">
      <label for="office-select">Office</label>
      <select id="office-select">
        <option value="">Loading offices…</option>
      </select>
    </div>
    <p>
      <a
        id="preview-link"
        href={`${previewBase}?office=denver`}
        data-preview-base={previewBase}
        target="_blank"
        rel="noopener"
      >Open calendar preview for this office →</a>
      <br />
      <a href={`${previewBase}#confirmation`} target="_blank" rel="noopener">
        Preview booking confirmation (before / after) →
      </a>
    </p>
    <h2>Booking rules</h2>
    <form id="office-config-form" class="admin-form">
      <div class="field"><label>Days ahead applicants can book</label><input name="bookingWindowDays" type="number" min="1" max="90" /></div>
      <div class="field"><label>Minimum notice (hours)</label><input name="minNoticeHours" type="number" min="0" /></div>
      <button type="submit" class="btn btn-secondary">Save booking rules</button>
    </form>
    <h2>Weekly hours</h2>
    <p class="admin-hint">Mon–Fri 10:00–16:00 is typical for Denver. Add one row per day that is open.</p>
    <div id="rules-list"></div>
    <h3>Add hours</h3>
    <form id="rule-form" class="admin-form admin-form--inline">
      <div class="field"><label>Day</label>
        <select name="dayOfWeek">
          <option value="0">Sunday</option>
          <option value="1">Monday</option>
          <option value="2">Tuesday</option>
          <option value="3">Wednesday</option>
          <option value="4">Thursday</option>
          <option value="5">Friday</option>
          <option value="6">Saturday</option>
        </select>
      </div>
      <div class="field"><label>Start</label><input name="startTime" value="10:00" pattern="[0-9]{2}:[0-9]{2}" title="HH:MM (24-hour), e.g. 10:00" required /></div>
      <div class="field"><label>End</label><input name="endTime" value="16:00" pattern="[0-9]{2}:[0-9]{2}" title="HH:MM (24-hour), e.g. 16:00" required /></div>
      <button type="submit" class="btn">Add</button>
    </form>

    <h2>Closed dates</h2>
    <p class="admin-hint">No interview slots on these days.</p>
    <div id="exceptions-list"></div>
    <form id="exception-form" class="admin-form admin-form--inline">
      <div class="field"><label>Date</label><input name="exceptionDate" type="date" required /></div>
      <button type="submit" class="btn btn-secondary">Add closed date</button>
    </form>

    <h2>Blocked times</h2>
    <p class="admin-hint">Block specific windows on a day (office local time).</p>
    <div id="blocks-list"></div>
    <form id="block-form" class="admin-form admin-form--inline">
      <div class="field"><label>Date</label><input name="localDate" type="date" required /></div>
      <div class="field"><label>Start</label><input name="startTime" value="14:00" pattern="[0-9]{2}:[0-9]{2}" title="HH:MM (24-hour), e.g. 14:00" required /></div>
      <div class="field"><label>End</label><input name="endTime" value="16:00" pattern="[0-9]{2}:[0-9]{2}" title="HH:MM (24-hour), e.g. 16:00" required /></div>
      <div class="field"><label>Note</label><input name="note" maxlength="500" placeholder="Optional" /></div>
      <button type="submit" class="btn btn-secondary">Add block</button>
    </form>

    <p id="sched-msg" class="admin-hint"></p>
  </div>
</AdminLayout>

<style>
  .admin-hint { color: var(--text-light); font-size: 0.875rem; }
  .admin-form--inline { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; }
  .admin-form--inline .field { margin-bottom: 0; }
</style>

<script>
  import { resolveAdminApiBaseUrl } from "../../../lib/api.client.ts";
  import { initAvailabilityEditor } from "../../../lib/officeAvailability.client.ts";

  const previewBase =
    document.getElementById("preview-link")?.dataset.previewBase ||
    "/hiring/schedule/preview/";

  function updatePreviewLink() {
    const sel = document.getElementById("office-select") as HTMLSelectElement;
    const slug = sel?.selectedOptions[0]?.dataset.slug || "denver";
    const link = document.getElementById("preview-link") as HTMLAnchorElement;
    if (link) link.href = `${previewBase}?office=${slug}`;
  }

  (async () => {
    await window.adminAuthCheck;
    const api = await resolveAdminApiBaseUrl();
    if (!api) return;
    const sel = document.getElementById("office-select") as HTMLSelectElement;
    const res = await fetch(`${api}/offices`, { credentials: "include" });
    const { offices } = await res.json();
    sel.innerHTML = offices
      .map(
        (o: { id: number; slug: string; name: string }) =>
          `<option value="${o.id}" data-slug="${o.slug}">${o.name}</option>`
      )
      .join("");
    sel.addEventListener("change", updatePreviewLink);
    updatePreviewLink();
    initAvailabilityEditor({
      mode: "admin",
      officeSelectId: "office-select",
      showBookingRules: true,
    });
  })();
</script>
