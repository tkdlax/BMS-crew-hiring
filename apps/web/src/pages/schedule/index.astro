---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleBookingSuccess from "../../components/schedule/ScheduleBookingSuccess.astro";
import ScheduleConfirmBar from "../../components/schedule/ScheduleConfirmBar.astro";
import { hrefPath } from "../../lib/assets";
import { PAGE_SEO } from "../../lib/seo";

const operationsUrl = hrefPath("operations/");
---
<BaseLayout
  title={PAGE_SEO.schedule.title}
  description={PAGE_SEO.schedule.description}
  ogImage={PAGE_SEO.schedule.ogImage}
  ogImageAlt="Family smiling after a successful Bailey's move"
  bodyClass="schedule-page schedule-page--calendly"
  noIndex
>
  <div class="page-wrap page-wrap--narrow">
    <div id="schedule-root">
      <div class="content-card" id="schedule-loading">
        <p class="lead">Loading your scheduling link…</p>
      </div>

      <div class="schedule-shell" id="schedule-book" hidden>
        <aside class="schedule-sidebar">
          <p class="schedule-sidebar__eyebrow">Interview scheduling</p>
          <h1 class="schedule-sidebar__title" id="sidebar-greeting">Schedule your interview</h1>
          <p class="schedule-sidebar__job" id="sidebar-job"></p>
          <p class="schedule-sidebar__interview" id="sidebar-interview"></p>
          <p class="schedule-sidebar__location">
            <span class="schedule-sidebar__location-icon" aria-hidden="true">📍</span>
            <span id="sidebar-location"></span>
          </p>
          <p class="schedule-sidebar__hint" id="sidebar-hint">Choose a date, then pick a time for your in-person interview.</p>
          <p class="schedule-sidebar__tz" id="sidebar-tz" hidden></p>
        </aside>
        <div class="schedule-picker">
          <div id="schedule-step-date">
            <div id="cal-root"></div>
          </div>
          <div id="schedule-step-time" hidden>
            <button type="button" class="cal-back" id="cal-back">← Change date</button>
            <p class="schedule-picker__heading">Select a time for your interview</p>
            <p class="cal-selected-day" id="cal-selected-day"></p>
            <div class="slot-list" id="time-slots"></div>
          </div>
          <div id="schedule-alert" class="alert alert-error" hidden style="margin-top: 1rem"></div>
        </div>
      </div>

      <div class="content-card" id="schedule-confirm" hidden>
        <p class="section-label">Confirm attendance</p>
        <h2 class="section-title" id="confirm-title">Will you attend your interview?</h2>
        <p class="lead schedule-success__intro" id="confirm-intro">
          Please confirm you can make your scheduled interview.
        </p>
        <div class="schedule-confirmation-details" id="confirm-details" hidden></div>
        <div class="schedule-success__actions">
          <button type="button" class="btn btn-secondary" id="confirm-calendar" hidden>
            Add to calendar
          </button>
        </div>
        <div class="confirm-actions">
          <button type="button" class="btn btn-primary" id="confirm-yes">Yes, I will attend</button>
          <button type="button" class="btn btn-secondary" id="confirm-no">I need to reschedule</button>
        </div>
        <p id="confirm-result" class="lead" hidden></p>
      </div>

      <ScheduleBookingSuccess />

      <div class="content-card" id="schedule-error" hidden>
        <p class="alert alert-error" id="error-message"></p>
        <a href={operationsUrl} class="btn btn-secondary" style="margin-top: 1rem;">View operations openings</a>
      </div>
    </div>
  </div>

  <ScheduleConfirmBar buttonId="confirm-btn" />
</BaseLayout>

<script>
  import { resolveApiBaseUrl, resolveHireApiBaseUrl } from "../../lib/api.client.ts";
  import { formatTimezoneLabel, initCalendlyPicker } from "../../lib/scheduleCalendar.ts";
  import {
    populateConfirmationDetails,
    renderScheduleConfirmation,
    wireCalendarDownload,
    type ScheduleConfirmationDetails,
  } from "../../lib/scheduleConfirmation.ts";

  function resolveToken() {
    const params = new URLSearchParams(window.location.search);
    if (params.get("token")) return params.get("token");
    const path = window.location.pathname;
    if (path.includes("/schedule/")) {
      const part = path.split("/schedule/")[1]?.replace(/\/$/, "");
      if (part && part !== "index.html" && part !== "" && part !== "preview") {
        return decodeURIComponent(part);
      }
    }
    return null;
  }

  const token = resolveToken();
  const loading = document.getElementById("schedule-loading");
  const bookShell = document.getElementById("schedule-book");
  const confirmBlock = document.getElementById("schedule-confirm");
  const done = document.getElementById("schedule-done");
  const errBlock = document.getElementById("schedule-error");
  const bar = document.getElementById("schedule-bar");
  const confirmBtn = document.getElementById("confirm-btn") as HTMLButtonElement;
  const alertEl = document.getElementById("schedule-alert") as HTMLElement;

  let selectedSlot: string | null = null;
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;

  function showError(msg: string) {
    loading!.hidden = true;
    bookShell!.hidden = true;
    errBlock!.hidden = false;
    document.getElementById("error-message")!.textContent = msg;
    bar!.hidden = true;
  }

  function scrollToBlock(el: HTMLElement) {
    requestAnimationFrame(() => {
      el.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function setSidebar(ctx: {
    firstName?: string;
    jobTitle: string;
    officeName: string;
    officeLocation: string;
    officeTimezone?: string;
    hint?: string;
    title?: string;
  }) {
    const greeting = document.getElementById("sidebar-greeting")!;
    greeting.textContent = ctx.title ?? (ctx.firstName ? `Hi, ${ctx.firstName}` : "Schedule your interview");
    document.getElementById("sidebar-job")!.textContent = `Interview for: ${ctx.jobTitle}`;
    document.getElementById("sidebar-interview")!.textContent =
      `You're scheduling an in-person interview at our ${ctx.officeName} office.`;
    document.getElementById("sidebar-location")!.textContent = ctx.officeLocation;
    if (ctx.hint) document.getElementById("sidebar-hint")!.textContent = ctx.hint;
    if (ctx.officeTimezone) {
      const tzEl = document.getElementById("sidebar-tz")!;
      tzEl.hidden = false;
      tzEl.textContent = `All times shown in ${formatTimezoneLabel(ctx.officeTimezone)}.`;
    }
  }

  if (!token) {
    showError("Missing scheduling link. Please use the link from your email or text message.");
  } else {
    resolveApiBaseUrl().then((api) => {
      if (!api) {
        showError("Scheduling is temporarily unavailable. Please try again later.");
        return;
      }
      load(api);
    });
  }

  async function load(apiBase: string) {
    const ctxRes = await fetch(`${apiBase}/schedule/${token}`);
    if (!ctxRes.ok) {
      const d = await ctxRes.json().catch(() => ({}));
      showError(d.error || "This link is invalid or has expired.");
      return;
    }
    const ctx = await ctxRes.json();

    if (ctx.mode === "confirm_attendance") {
      loading!.hidden = true;
      confirmBlock!.hidden = false;
      bar!.hidden = true;
      const details: ScheduleConfirmationDetails = {
        firstName: ctx.firstName ?? "",
        jobTitle: ctx.jobTitle,
        officeName: ctx.officeName,
        officeLocation: ctx.officeLocation,
        locationNotes: ctx.locationNotes,
        interviewTimeLocal: ctx.interviewTimeLocal,
        primaryInterest: ctx.primaryInterest,
        startsAt: ctx.startsAt,
        endsAt: ctx.endsAt,
      };
      populateConfirmationDetails(document.getElementById("confirm-details")!, details);
      wireCalendarDownload(
        document.getElementById("confirm-calendar") as HTMLButtonElement,
        details
      );
      if (ctx.attendanceStatus === "confirmed") {
        document.getElementById("confirm-title")!.textContent = "You're confirmed";
        (document.querySelector(".confirm-actions") as HTMLElement).hidden = true;
        const result = document.getElementById("confirm-result")!;
        result.hidden = false;
        result.textContent = "Thank you — we have your confirmation on file.";
      }
      scrollToBlock(confirmBlock!);
      return;
    }

    setSidebar({
      firstName: ctx.firstName,
      jobTitle: ctx.jobTitle,
      officeName: ctx.officeName,
      officeLocation: ctx.officeLocation,
      officeTimezone: ctx.officeTimezone,
      hint: "Choose a date, then select a time for your interview.",
    });

    const slotsRes = await fetch(`${apiBase}/schedule/${token}/slots`);
    if (!slotsRes.ok) {
      showError("Could not load available times.");
      return;
    }
    const { slots } = await slotsRes.json();
    loading!.hidden = true;
    bookShell!.hidden = false;
    bar!.hidden = false;

    if (!slots.length) {
      document.getElementById("schedule-step-date")!.innerHTML =
        '<p class="lead">No times are available in the next two weeks. Please call <a href="tel:+18882605717" style="color:var(--orange);font-weight:700">888-260-5717</a> to schedule with our team.</p>';
      bar!.hidden = true;
      return;
    }

    initCalendlyPicker({
      slots,
      calendarEl: document.getElementById("cal-root")!,
      dateStepEl: document.getElementById("schedule-step-date")!,
      timeStepEl: document.getElementById("schedule-step-time")!,
      selectedDayEl: document.getElementById("cal-selected-day")!,
      timeListEl: document.getElementById("time-slots")!,
      backBtn: document.getElementById("cal-back") as HTMLButtonElement,
      dateHeading: "Select a date for your interview",
      timeHeading: "Select a time for your interview",
      onTimeSelect: (start) => {
        selectedSlot = start;
        confirmBtn.disabled = false;
      },
    });
  }

  async function submitAttendance(apiBase: string, attending: boolean) {
    const res = await fetch(`${apiBase}/schedule/${token}/confirm-attendance`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ attending }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "Could not save your response");
    (document.querySelector(".confirm-actions") as HTMLElement).hidden = true;
    const result = document.getElementById("confirm-result")!;
    result.hidden = false;
    result.textContent = data.message;
    document.getElementById("confirm-title")!.textContent = attending
      ? "You're confirmed"
      : "Thanks for letting us know";
  }

  document.getElementById("confirm-yes")?.addEventListener("click", async () => {
    const apiBase = await resolveHireApiBaseUrl();
    if (!apiBase) return;
    try {
      await submitAttendance(apiBase, true);
    } catch (e) {
      alert((e as Error).message);
    }
  });

  document.getElementById("confirm-no")?.addEventListener("click", async () => {
    const apiBase = await resolveHireApiBaseUrl();
    if (!apiBase) return;
    try {
      await submitAttendance(apiBase, false);
    } catch (e) {
      alert((e as Error).message);
    }
  });

  confirmBtn?.addEventListener("click", async () => {
    if (!selectedSlot || !token) return;
    const api = await resolveHireApiBaseUrl();
    if (!api) return;
    confirmBtn.disabled = true;
    try {
      const res = await fetch(`${api}/schedule/${token}/book`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slotStart: selectedSlot, applicantTimezone: tz }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Booking failed");
      bookShell!.hidden = true;
      bar!.hidden = true;
      done!.hidden = false;
      renderScheduleConfirmation("schedule-done", {
        firstName: data.firstName ?? "",
        lastName: data.lastName,
        jobTitle: data.jobTitle,
        officeName: data.officeName,
        officeLocation: data.officeLocation,
        locationNotes: data.locationNotes,
        interviewTimeLocal: data.interviewTimeLocal,
        primaryInterest: data.primaryInterest,
        startsAt: data.startsAt,
        endsAt: data.endsAt,
      });
      scrollToBlock(done!);
    } catch (e) {
      alertEl.hidden = false;
      alertEl.textContent = (e as Error).message;
      confirmBtn.disabled = false;
    }
  });
</script>
