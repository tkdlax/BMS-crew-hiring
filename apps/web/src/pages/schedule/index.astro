---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { hrefPath } from "../../lib/assets";

const careersUrl = hrefPath("careers/");
---
<BaseLayout title="Schedule interview" bodyClass="schedule-page">
  <section class="page-band">
    <div class="page-band__inner">
      <p class="eyebrow">Interview</p>
      <h1 id="band-title">Schedule your interview</h1>
      <p class="sub" id="band-sub">Pick a time that works for you.</p>
    </div>
  </section>

  <div class="page-wrap page-wrap--narrow">
    <div class="content-card" id="schedule-root">
      <div id="schedule-loading">
        <p class="lead">Loading available times…</p>
      </div>
      <div id="schedule-content" hidden>
        <p class="section-label">Select a time</p>
        <p class="lead" style="margin-bottom: 1rem;">
          <strong id="job-title"></strong> · <span id="office-name"></span> (<span id="office-location"></span>)
        </p>
        <div id="schedule-alert" hidden></div>
        <div class="slot-days" id="slot-days"></div>
      </div>
      <div id="schedule-done" hidden>
        <p class="section-label">Confirmed</p>
        <h2 class="section-title">You&apos;re all set!</h2>
        <p class="lead">
          Your interview is confirmed. Check your email and text for details. We look forward to meeting you.
        </p>
      </div>
      <div id="schedule-error" hidden>
        <p class="alert alert-error" id="error-message"></p>
        <a href={careersUrl} class="btn btn-secondary" style="margin-top: 1rem;">View operations openings</a>
      </div>
    </div>
  </div>

  <div class="schedule-bar" id="schedule-bar" hidden>
    <button type="button" class="btn btn-primary" id="confirm-btn" disabled>
      Confirm selected time
    </button>
  </div>
</BaseLayout>

<script>
  import { resolveApiBaseUrl } from "../../lib/api.client.ts";

  function resolveToken() {
    const params = new URLSearchParams(window.location.search);
    if (params.get("token")) return params.get("token");
    const path = window.location.pathname;
    if (path.includes("/schedule/")) {
      const part = path.split("/schedule/")[1]?.replace(/\/$/, "");
      if (part && part !== "index.html" && part !== "") return decodeURIComponent(part);
    }
    return null;
  }

  const token = resolveToken();
  const loading = document.getElementById("schedule-loading");
  const content = document.getElementById("schedule-content");
  const done = document.getElementById("schedule-done");
  const errBlock = document.getElementById("schedule-error");
  const bar = document.getElementById("schedule-bar");
  const confirmBtn = document.getElementById("confirm-btn");
  const slotDays = document.getElementById("slot-days");
  const alertEl = document.getElementById("schedule-alert");
  const bandTitle = document.getElementById("band-title");
  const bandSub = document.getElementById("band-sub");

  let selectedSlot = null;
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;

  function showError(msg) {
    loading.hidden = true;
    content.hidden = true;
    errBlock.hidden = false;
    document.getElementById("error-message").textContent = msg;
    bar.hidden = true;
  }

  if (!token) {
    showError("Missing scheduling link. Please use the link from your email.");
  } else {
    resolveApiBaseUrl().then((api) => {
      if (!api) {
        showError("Scheduling is temporarily unavailable. Please try again later.");
        return;
      }
      load(api);
    });
  }

  function groupByDay(slots) {
    const map = new Map();
    for (const s of slots) {
      const day = s.startsAt.slice(0, 10);
      if (!map.has(day)) map.set(day, []);
      map.get(day).push(s);
    }
    return map;
  }

  function formatDay(isoDate) {
    const d = new Date(isoDate + "T12:00:00");
    return d.toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" });
  }

  async function load() {
    const ctxRes = await fetch(`${api}/schedule/${token}`);
    if (!ctxRes.ok) {
      const d = await ctxRes.json().catch(() => ({}));
      showError(d.error || "This link is invalid or has expired.");
      return;
    }
    const ctx = await ctxRes.json();
    if (bandTitle) bandTitle.textContent = `Hi, ${ctx.firstName}`;
    if (bandSub) bandSub.textContent = "Choose a time for your interview below.";

    const from = new Date().toISOString().slice(0, 10);
    const to = new Date(Date.now() + 14 * 86400000).toISOString().slice(0, 10);
    const slotsRes = await fetch(`${api}/schedule/${token}/slots?from=${from}&to=${to}`);
    if (!slotsRes.ok) {
      showError("Could not load available times.");
      return;
    }
    const { slots } = await slotsRes.json();
    loading.hidden = true;
    content.hidden = false;
    bar.hidden = false;

    if (!slots.length) {
      slotDays.innerHTML =
        '<p class="lead">No times are available in the next two weeks. Please call <a href="tel:+18882605717" style="color:var(--orange);font-weight:700">888-260-5717</a>.</p>';
      bar.hidden = true;
      return;
    }

    const grouped = groupByDay(slots);
    slotDays.innerHTML = "";
    for (const [day, daySlots] of grouped) {
      const section = document.createElement("div");
      section.className = "slot-day";
      section.innerHTML = `<h2>${formatDay(day)}</h2><div class="slot-list"></div>`;
      const list = section.querySelector(".slot-list");
      for (const s of daySlots) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "slot-btn";
        btn.textContent = s.labelLocal;
        btn.dataset.start = s.startsAt;
        btn.addEventListener("click", () => {
          document.querySelectorAll(".slot-btn.selected").forEach((el) => el.classList.remove("selected"));
          btn.classList.add("selected");
          selectedSlot = s.startsAt;
          confirmBtn.disabled = false;
        });
        list.appendChild(btn);
      }
      slotDays.appendChild(section);
    }
  }

  confirmBtn?.addEventListener("click", async () => {
    if (!selectedSlot || !token) return;
    const api = await resolveApiBaseUrl();
    if (!api) return;
    confirmBtn.disabled = true;
    try {
      const res = await fetch(`${api}/schedule/${token}/book`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ slotStart: selectedSlot, applicantTimezone: tz }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Booking failed");
      content.hidden = true;
      bar.hidden = true;
      done.hidden = false;
      if (bandTitle) bandTitle.textContent = "Interview confirmed";
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch (e) {
      alertEl.hidden = false;
      alertEl.className = "alert alert-error";
      alertEl.textContent = e.message;
      confirmBtn.disabled = false;
    }
  });
</script>
