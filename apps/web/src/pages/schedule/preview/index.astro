---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ScheduleBookingSuccess from "../../../components/schedule/ScheduleBookingSuccess.astro";
import ScheduleConfirmBar from "../../../components/schedule/ScheduleConfirmBar.astro";
import { hrefPath } from "../../../lib/assets";
import { PAGE_SEO } from "../../../lib/seo";

const operationsUrl = hrefPath("operations/");
---
<BaseLayout
  title={PAGE_SEO.schedulePreview.title}
  description={PAGE_SEO.schedulePreview.description}
  ogImage={PAGE_SEO.schedulePreview.ogImage}
  ogImageAlt="Allied tractor and trailer ready for the road"
  bodyClass="schedule-page schedule-page--calendly"
  noIndex
>
  <section class="page-band">
    <div class="page-band__inner">
      <p class="eyebrow">Preview</p>
      <h1>Schedule calendar preview</h1>
      <p class="sub">Test interview availability without submitting an application.</p>
    </div>
  </section>

  <div class="page-wrap page-wrap--narrow">
    <div class="content-card" style="margin-bottom: 1rem">
      <div class="field">
        <label for="office-select">Office</label>
        <select id="office-select">
          <option value="denver">Denver</option>
          <option value="colorado-springs">Colorado Springs</option>
          <option value="grand-junction">Grand Junction</option>
          <option value="salt-lake-city">Salt Lake City</option>
        </select>
      </div>
      <button type="button" class="btn btn-primary" id="load-preview">Load preview slots</button>
      <p id="preview-meta" class="form-hint" style="margin-top: 1rem"></p>
    </div>

    <div class="schedule-shell" id="preview-shell" hidden>
      <aside class="schedule-sidebar">
        <p class="schedule-sidebar__eyebrow">Interview scheduling</p>
        <h1 class="schedule-sidebar__title" id="preview-job-title">Schedule your interview</h1>
        <p class="schedule-sidebar__job" id="preview-role"></p>
        <p class="schedule-sidebar__interview" id="preview-interview"></p>
        <p class="schedule-sidebar__location">
          <span class="schedule-sidebar__location-icon" aria-hidden="true">📍</span>
          <span id="preview-office-location"></span>
        </p>
        <p class="schedule-sidebar__hint">Applicant view — booking rules shown above, not on the live page.</p>
        <p class="schedule-sidebar__tz" id="preview-tz" hidden></p>
      </aside>
      <div class="schedule-picker">
        <div id="schedule-step-date">
          <div id="cal-root"></div>
        </div>
        <div id="schedule-step-time" hidden>
          <button type="button" class="cal-back" id="cal-back">← Change date</button>
          <p class="schedule-picker__heading">Select a time for your interview</p>
          <p class="cal-selected-day" id="cal-selected-day"></p>
          <div class="slot-list" id="time-slots"></div>
        </div>
      </div>
    </div>

    <p style="margin-top: 1.5rem">
      <a href={operationsUrl}>← Back to operations openings</a>
    </p>

    <div class="content-card preview-confirm-panel" id="confirmation-preview" style="margin-top: 2.5rem">
      <p class="section-label">Preview</p>
      <h2 class="section-title" style="margin-bottom: 0.5rem">Booking confirmation</h2>
      <p class="form-hint" style="margin-bottom: 1rem">
        See the mobile applicant view before and after tapping <strong>Confirm interview time</strong>.
        The after view auto-scrolls like the live scheduling page.
      </p>
      <div class="preview-confirm-toggle">
        <button type="button" class="btn btn-secondary" id="preview-view-before" aria-pressed="true">
          Before confirm
        </button>
        <button type="button" class="btn btn-primary" id="preview-view-after" aria-pressed="false">
          After confirm
        </button>
      </div>
    </div>

    <div id="preview-confirm-stage" style="margin-top: 1rem">
      <div class="schedule-shell" id="preview-confirm-before" hidden>
        <aside class="schedule-sidebar">
          <p class="schedule-sidebar__eyebrow">Interview scheduling</p>
          <h1 class="schedule-sidebar__title">Hi, Alex</h1>
          <p class="schedule-sidebar__job">Interview for: Moving Operations Crew</p>
          <p class="schedule-sidebar__interview">
            You&apos;re scheduling an in-person interview at our Denver office.
          </p>
          <p class="schedule-sidebar__location">
            <span class="schedule-sidebar__location-icon" aria-hidden="true">📍</span>
            <span>11755 E Peakview Ave, Centennial, CO 80111</span>
          </p>
          <p class="schedule-sidebar__hint">Choose a date, then select a time for your interview.</p>
          <p class="schedule-sidebar__tz">All times shown in Mountain Time.</p>
        </aside>
        <div class="schedule-picker">
          <button type="button" class="cal-back" disabled style="opacity: 0.6; cursor: default">← Change date</button>
          <p class="schedule-picker__heading">Select a time for your interview</p>
          <p class="cal-selected-day">Wednesday, January 15, 2030</p>
          <div class="slot-list">
            <button type="button" class="slot-btn selected" disabled>10:00 AM MT</button>
            <button type="button" class="slot-btn" disabled style="opacity: 0.45">10:30 AM MT</button>
            <button type="button" class="slot-btn" disabled style="opacity: 0.45">11:00 AM MT</button>
          </div>
          <p class="form-hint" style="margin-top: 1rem">Sample preview — time is selected; confirm bar appears at the bottom.</p>
        </div>
      </div>

      <ScheduleBookingSuccess id="preview-confirm-after" />
    </div>
  </div>

  <ScheduleConfirmBar id="preview-confirm-bar" buttonId="preview-confirm-btn" disabled={false} />
</BaseLayout>

<style>
  .preview-confirm-toggle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .preview-confirm-toggle .btn[aria-pressed="true"] {
    box-shadow: inset 0 0 0 2px var(--blue);
  }

  #preview-confirm-bar:not([hidden]) {
    display: block;
  }
</style>

<script>
  import { resolveApiBaseUrl } from "../../../lib/api.client.ts";
  import { formatTimezoneLabel, initCalendlyPicker } from "../../../lib/scheduleCalendar.ts";
  import {
    PREVIEW_CONFIRMATION,
    renderScheduleConfirmation,
  } from "../../../lib/scheduleConfirmation.ts";

  const params = new URLSearchParams(window.location.search);
  const officeParam = params.get("office");
  if (officeParam) {
    const sel = document.getElementById("office-select") as HTMLSelectElement;
    if ([...sel.options].some((o) => o.value === officeParam)) sel.value = officeParam;
  }

  document.getElementById("load-preview")?.addEventListener("click", async () => {
    const loadBtn = document.getElementById("load-preview") as HTMLButtonElement;
    const api = await resolveApiBaseUrl();
    if (!api) {
      alert("API not configured");
      return;
    }
    loadBtn.classList.add("is-loading");
    loadBtn.disabled = true;
    try {
    const office = (document.getElementById("office-select") as HTMLSelectElement).value;
    const res = await fetch(`${api}/public/schedule-preview/${office}?job=moving-operations-crew`);
    const data = await res.json();
    if (!res.ok) {
      alert(data.error || "Preview failed");
      return;
    }

    document.getElementById("preview-meta")!.textContent =
      `${data.officeName} · ${data.jobTitle} · ${data.slots.length} slots · book up to ${data.bookingWindowDays} days ahead · ${data.minNoticeHours}h notice`;

    document.getElementById("preview-job-title")!.textContent = "Schedule your interview";
    document.getElementById("preview-role")!.textContent = `Interview for: ${data.jobTitle}`;
    document.getElementById("preview-interview")!.textContent =
      `You're scheduling an in-person interview at our ${data.officeName} office.`;
    document.getElementById("preview-office-location")!.textContent =
      data.officeLocation || data.officeName;
    if (data.officeTimezone) {
      const tzEl = document.getElementById("preview-tz")!;
      tzEl.hidden = false;
      tzEl.textContent = `All times shown in ${formatTimezoneLabel(data.officeTimezone)}.`;
    }

    const shell = document.getElementById("preview-shell")!;
    shell.hidden = false;

    if (!data.slots.length) {
      document.getElementById("schedule-step-date")!.innerHTML =
        "<p>No interview slots in the next two weeks with current rules.</p>";
      return;
    }

    initCalendlyPicker({
      slots: data.slots,
      calendarEl: document.getElementById("cal-root")!,
      dateStepEl: document.getElementById("schedule-step-date")!,
      timeStepEl: document.getElementById("schedule-step-time")!,
      selectedDayEl: document.getElementById("cal-selected-day")!,
      timeListEl: document.getElementById("time-slots")!,
      backBtn: document.getElementById("cal-back") as HTMLButtonElement,
      dateHeading: "Select a date for your interview",
      timeHeading: "Select a time for your interview",
      readOnly: true,
    });
    } finally {
      loadBtn.classList.remove("is-loading");
      loadBtn.disabled = false;
    }
  });

  if (officeParam) {
    document.getElementById("load-preview")?.click();
  }

  const previewBeforeShell = document.getElementById("preview-confirm-before")!;
  const previewAfterCard = document.getElementById("preview-confirm-after")!;
  const previewConfirmBar = document.getElementById("preview-confirm-bar")!;
  const btnBefore = document.getElementById("preview-view-before")!;
  const btnAfter = document.getElementById("preview-view-after")!;

  function scrollToBlock(el: HTMLElement) {
    requestAnimationFrame(() => {
      el.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function showPreviewBefore() {
    previewBeforeShell.hidden = false;
    previewAfterCard.hidden = true;
    previewConfirmBar.hidden = false;
    btnBefore.setAttribute("aria-pressed", "true");
    btnAfter.setAttribute("aria-pressed", "false");
    scrollToBlock(previewBeforeShell);
  }

  function showPreviewAfter() {
    previewBeforeShell.hidden = true;
    previewAfterCard.hidden = false;
    previewConfirmBar.hidden = true;
    btnBefore.setAttribute("aria-pressed", "false");
    btnAfter.setAttribute("aria-pressed", "true");
    renderScheduleConfirmation("preview-confirm-after", PREVIEW_CONFIRMATION);
    scrollToBlock(previewAfterCard);
  }

  btnBefore.addEventListener("click", showPreviewBefore);
  btnAfter.addEventListener("click", showPreviewAfter);

  previewConfirmBar.querySelector("button")?.addEventListener("click", showPreviewAfter);

  const confirmSection = document.getElementById("confirmation-preview");
  const viewParam = new URLSearchParams(window.location.search).get("view");
  if (window.location.hash === "#confirmation" || viewParam === "before" || viewParam === "after") {
    if (window.location.hash === "#confirmation") {
      confirmSection?.scrollIntoView({ behavior: "smooth", block: "start" });
    }
    if (viewParam === "after") showPreviewAfter();
    else showPreviewBefore();
  } else {
    previewBeforeShell.hidden = true;
    previewAfterCard.hidden = true;
    previewConfirmBar.hidden = true;
  }
</script>
