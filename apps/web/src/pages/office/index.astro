---
import OfficeLayout from "../../layouts/OfficeLayout.astro";
import InterviewCalendar from "../../components/admin/InterviewCalendar.astro";
---
<OfficeLayout title="Interview calendar" activeNav="calendar">
  <p class="admin-hint" style="margin-bottom: 1rem">
    Upcoming interviews for your office. Subscribe in your calendar app using the link below.
  </p>
  <div class="admin-card office-feed-card" id="office-feed-card" style="margin-bottom: 1rem" hidden>
    <h2 class="office-feed-card__title">Calendar subscription</h2>
    <p class="admin-hint">
      Outlook and Google Calendar: copy the HTTPS link. Apple Calendar: use <strong>Add to Apple Calendar</strong> (opens a <code>webcal://</code> subscribe link).
    </p>
    <div class="field">
      <input type="text" id="office-feed-url" readonly class="admin-feed-url" aria-label="Calendar subscription URL" />
    </div>
    <div class="table-actions office-feed-actions">
      <button type="button" class="btn btn-secondary btn-small" id="copy-feed-url">Copy calendar link</button>
      <a
        id="apple-calendar-link"
        class="btn btn-secondary btn-small"
        href="#"
        hidden
        rel="noopener"
      >
        Add to Apple Calendar
      </a>
    </div>
    <p id="copy-feed-msg" class="admin-hint office-feed-msg" hidden role="status">Calendar link copied.</p>
  </div>
  <InterviewCalendar mode="office" showOfficeSelect={false} />
</OfficeLayout>

<script>
  import { resolveOfficeApiBaseUrl } from "../../lib/api.client.ts";
  import { buildCalendarFeedUrl, buildWebcalFeedUrl } from "../../lib/calendarFeedUrl";

  (async () => {
    await window.officeAuthCheck;
    const api = await resolveOfficeApiBaseUrl();
    if (!api) return;
    const sess = await fetch(`${api}/session`, { credentials: "include" }).then((r) => r.json());
    const office = sess.office;
    if (!office?.calendarFeedToken || !office?.slug) return;
    const httpsUrl = buildCalendarFeedUrl(office.slug, office.calendarFeedToken);
    const webcalUrl = buildWebcalFeedUrl(httpsUrl);
    const card = document.getElementById("office-feed-card");
    const input = document.getElementById("office-feed-url") as HTMLInputElement;
    const copyMsg = document.getElementById("copy-feed-msg");
    const appleLink = document.getElementById("apple-calendar-link") as HTMLAnchorElement;
    if (card && input) {
      input.value = httpsUrl;
      card.hidden = false;
    }
    if (appleLink) {
      appleLink.href = webcalUrl;
      appleLink.hidden = false;
    }
    document.getElementById("copy-feed-url")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(httpsUrl);
        if (copyMsg) {
          copyMsg.hidden = false;
          window.setTimeout(() => {
            copyMsg.hidden = true;
          }, 2500);
        }
      } catch {
        input?.select();
      }
    });
  })();
</script>
